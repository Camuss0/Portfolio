---
import type { Project } from "../../types/data";
import Tag from "../ui/Tag.astro";
import { t, type Lang } from "../../i18n/ui";
import { getSkillIcon } from "../../utils/icons";
export interface Props {
  project: Project;
  lang: Lang;
}
const { project, lang } = Astro.props;
const topStack = project.tech_stack.slice(0, 3);
---

<button
  class="group block w-full text-left bg-[#111113] border border-[#1f1f22] rounded-xl p-5 sm:p-7 cursor-pointer hover:border-[#2e2e33] transition-all duration-300 reveal-scale"
  data-project-id={project.id}
  data-open-modal=""
>
  <!-- Company + Client badges -->
  {project.company && (
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="inline-flex items-center gap-1.5 text-[0.625rem] text-[#7a7a85] bg-[#0a0a0b] border border-[#1f1f22] px-2.5 py-1 rounded-full font-mono">
        {t(lang, "badge.developed_at", { company: project.company })}
      </span>
      {project.client && (
        <span class="inline-flex items-center gap-1.5 text-[0.6875rem] text-[#f4f4f5] bg-[#f97316]/10 border border-[#f97316]/20 px-2.5 py-1 rounded-full font-medium">
          {project.client_logo && (
            <img src={project.client_logo} alt="" class="w-4 h-4 rounded-full object-cover flex-shrink-0" />
          )}
          {project.client}
        </span>
      )}
    </div>
  )}

  <div class="flex items-start justify-between gap-3 mb-3">
    <h3 class="font-semibold text-[#f4f4f5] text-[1rem] sm:text-[1.125rem] leading-snug group-hover:text-[#f97316] transition-colors duration-300">
      {project.name}
    </h3>
    <span class="inline-block text-[0.625rem] text-[#71717a] bg-[#1f1f22] px-2 py-0.5 rounded-full font-medium tracking-wide whitespace-nowrap">
      {project.type}
    </span>
  </div>

  <p class="text-[0.75rem] sm:text-[0.8125rem] text-[#a1a1aa] leading-[1.65] mb-5 line-clamp-2">
    {project.short_description}
  </p>

  {topStack.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {topStack.map((s) => <Tag label={s} mono={true} icon={getSkillIcon(s)} />)}
    </div>
  )}

  <div class="mt-5 flex items-center gap-2 text-[0.75rem] text-[#7a7a85] group-hover:text-[#f97316] transition-colors duration-300">
    <span class="font-medium">{t(lang, "cta.details")}</span>
    <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </div>
</button>
