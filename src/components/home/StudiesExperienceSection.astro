---
import { t, type Lang } from "../../i18n/ui";
import type { Study, Certification, Experience } from "../../types/data";
export interface Props {
  studies: Study[];
  certifications: Certification[];
  experience: Experience[];
  lang: Lang;
}
const { studies, certifications, experience, lang } = Astro.props;

const hasStudies = studies.length > 0 || certifications.length > 0;
const hasExperience = experience.length > 0;
const showDual = hasStudies && hasExperience;
---

<section id="studies" class="py-16 sm:py-20 md:py-28 border-t border-[#1f1f22]/40 reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 gap-10 sm:gap-16" class:list={{ "lg:grid-cols-2": showDual }}>
      <!-- LEFT COLUMN: Education & Certifications -->
      {
        hasStudies && (
          <div>
            <div class="flex items-center gap-4 mb-8 sm:mb-12">
              <div class="w-6 h-[3px] bg-[#f97316] rounded-full"></div>
              <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#f4f4f5] leading-[1.1] -tracking-[0.02em]">
                {t(lang, "section.education")}
              </h2>
            </div>

            <!-- Timeline -->
            <div class="relative pl-9">
              <!-- Vertical line -->
              <div class="absolute left-[13px] top-2 bottom-2 w-px bg-[#1f1f22]"></div>

              <!-- Study entries -->
              {
                studies.map((study) => (
                  <div class="relative pb-10 last:pb-0">
                    <!-- Timeline dot -->
                    <div class="absolute -left-[31px] top-[18px] w-[17px] h-[17px] rounded-full bg-[#f97316] border-[3px] border-[#0a0a0b] ring-1 ring-[#f97316]/30"></div>
                    <!-- Card -->
                    <div class="flex items-start gap-4 px-4 py-4 sm:px-5 sm:py-5 bg-[#111113] border border-[#1f1f22] rounded-xl">
                      <div class="w-10 h-10 rounded-lg bg-[#f97316]/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                        {study.completed ? (
                          <svg class="w-5 h-5 text-[#f97316]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.499 5.221 51.137 51.137 0 00-2.658.813m-15.482 0A50.55 50.55 0 0112 13.489a50.55 50.55 0 0112-3.342" />
                          </svg>
                        ) : (
                          <svg class="w-5 h-5 text-[#7a7a85]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
                          </svg>
                        )}
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-3 flex-wrap">
                          <h3 class="text-[0.8125rem] sm:text-[0.9375rem] text-[#f4f4f5] font-semibold">{study.title}</h3>
                          {study.completed && (
                            <span class="text-[0.625rem] font-medium tracking-wide text-[#f97316] bg-[#f97316]/10 px-2 py-0.5 rounded-full uppercase">{t(lang, "study.completed")}</span>
                          )}
                          {!study.completed && (
                            <span class="text-[0.625rem] font-medium tracking-wide text-[#7a7a85] bg-[#1f1f22] px-2 py-0.5 rounded-full uppercase">{t(lang, "study.incomplete")}</span>
                          )}
                        </div>
                        <p class="text-[0.75rem] text-[#71717a] mt-1">{study.institution}</p>
                        <p class="text-[0.75rem] text-[#52525b] mt-0.5">{study.period}</p>
                        {study.highlights && study.highlights.length > 0 && (
                          <div class="flex flex-wrap gap-2 mt-3">
                            {study.highlights.map((h) => (
                              <span class="text-[0.6875rem] text-[#a1a1aa] bg-[#0a0a0b] border border-[#1f1f22] px-2.5 py-1 rounded-full font-mono">{h}</span>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                ))
              }

              <!-- Certifications -->
              {
                certifications.length > 0 && (
                  <div class="mt-10">
                    <h3 class="text-[0.6875rem] font-medium tracking-[0.08em] uppercase text-[#71717a] mb-4">
                      {lang === "es" ? "Certificaciones" : "Certifications"}
                    </h3>
                    <div class="space-y-4">
                      {certifications.map((cert) => (
            <div class="relative">
                          <div class="absolute -left-[31px] top-[18px] w-[17px] h-[17px] rounded-full border-[3px] border-[#0a0a0b] ring-1 ring-[#71717a]/30 bg-[#71717a]"></div>
                          <a href={cert.url} target="_blank" rel="noopener noreferrer" class="flex items-start gap-4 px-5 py-4 bg-[#111113] border border-[#1f1f22] rounded-xl hover:border-[#2e2e33] transition-all duration-200 no-underline group">
                            <div class="w-10 h-10 rounded-lg bg-[#f97316]/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                              <svg class="w-5 h-5 text-[#f97316]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                              </svg>
                            </div>
                            <div class="flex-1 min-w-0">
                              <div class="flex items-center gap-2">
                                <h4 class="text-[0.875rem] text-[#f4f4f5] font-semibold group-hover:text-[#f97316] transition-colors duration-200">{cert.name}</h4>
                                <svg class="w-3.5 h-3.5 text-[#71717a] group-hover:text-[#f97316] transition-colors duration-200 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                                </svg>
                              </div>
                              <p class="text-[0.75rem] text-[#a1a1aa] mt-0.5">
                                {cert.score} · {cert.level}
                              </p>
                              <p class="text-[0.6875rem] text-[#52525b] mt-0.5">{cert.date}</p>
                            </div>
                          </a>
                        </div>
                      ))}
                    </div>
                  </div>
                )
              }
            </div>
          </div>
        )
      }

      <!-- RIGHT COLUMN: Experience -->
      {
        hasExperience && (
          <div>
            <span id="experience" class="block"></span>
            <div class="flex items-center gap-4 mb-8 sm:mb-12">
              <div class="w-6 h-[3px] bg-[#172de2] rounded-full"></div>
              <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#f4f4f5] leading-[1.1] -tracking-[0.02em]">
                {t(lang, "section.experience")}
              </h2>
            </div>

            <!-- Timeline -->
            <div class="relative pl-9">
              <div class="absolute left-[13px] top-2 bottom-2 w-px bg-[#1f1f22]"></div>

              {
                experience.map((exp) => (
                  <div class="relative pb-10 last:pb-0">
                    <!-- Timeline dot -->
                    <div class="absolute -left-[31px] top-[18px] w-[17px] h-[17px] rounded-full bg-[#172de2] border-[3px] border-[#0a0a0b] ring-1 ring-[#172de2]/30"></div>
                    <!-- Card -->
                    <div class="px-4 py-4 sm:px-5 sm:py-5 bg-[#111113] border border-[#1f1f22] rounded-xl">
                      <div class="flex items-start gap-4">
                        <div class="w-10 h-10 rounded-lg bg-[#172de2]/10 flex items-center justify-center flex-shrink-0 mt-0.5 overflow-hidden">
                          {exp.company_logo ? (
                            <img src={exp.company_logo} alt={exp.company ?? ""} class="w-full h-full object-contain p-1" />
                          ) : (
                            <svg class="w-5 h-5 text-[#172de2]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.083.3-4.35.717-6.728.737-2.378.02-4.623-.354-6.63-.862a18.634 18.634 0 01-1.87-.663c-.597-.268-1.026-.79-1.026-1.43V7.852c0-1.077.768-2.015 1.837-2.175a47.22 47.22 0 015.653-.594c2.378-.02 4.644.355 6.651.863.229.063.456.13.678.204a2.25 2.25 0 011.87 2.17v4.25m-5.75 2.25h-9m9 0h3m-3 2.25h-9m9 0h3m-3 2.25h-9m9 0h3" />
                            </svg>
                          )}
                        </div>
                        <div class="flex-1 min-w-0">
                          <h3 class="font-semibold text-[#f4f4f5] text-[0.9375rem] sm:text-[1.0625rem]">
                            {exp.title}
                          </h3>
                          <div class="flex flex-wrap items-center gap-3 mt-1 text-[0.75rem] text-[#71717a]">
                            {exp.company && <span>{exp.company}</span>}
                            {exp.company && exp.period && <span class="w-1 h-1 rounded-full bg-[#2e2e33]"></span>}
                            {exp.period && <span>{exp.period}</span>}
                          </div>
                        </div>
                      </div>
                      {exp.description && (
                        <p class="text-[0.8125rem] text-[#a1a1aa] leading-[1.65] mt-4">
                          {exp.description}
                        </p>
                      )}
                      {exp.skills_demonstrated.length > 0 && (
                        <div class="flex flex-wrap gap-2 mt-4">
                          {exp.skills_demonstrated.map((s) => (
                            <span class="font-mono text-[0.5625rem] sm:text-[0.625rem] text-[#71717a] bg-[#0a0a0b] border border-[#1f1f22] px-2 py-0.5 rounded-full">
                              {s}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
