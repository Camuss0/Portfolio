---
import type { Skills } from "../../types/data";
import Tag from "../ui/Tag.astro";
import { t, type Lang } from "../../i18n/ui";
import { getSkillIcon } from "../../utils/icons";
export interface Props {
  skills: Skills;
  lang: Lang;
}
const { skills, lang } = Astro.props;

const categories: [string, string[]][] = [
  ["skill.frontend", skills.frontend],
  ["skill.backend", skills.backend],
  ["skill.infrastructure", skills.infrastructure],
  ["skill.automation", skills.automation],
  ["skill.aiTools", skills.ai_tools],
  ["skill.other", skills.other],
].filter(([, items]) => items.length > 0);
---

<section id="skills" class="py-16 sm:py-20 md:py-28 border-t border-[#1f1f22]/40 reveal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 sm:gap-12">
      <!-- Left Column: Header -->
      <div class="lg:w-[30%] lg:sticky lg:top-24">
        <div class="w-6 h-[3px] bg-[#f97316] rounded-full mb-4"></div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#f4f4f5] leading-[1.1] -tracking-[0.02em]">
          {t(lang, "section.skills")}
        </h2>
      </div>

      <!-- Right Column: Skills Grid -->
      <div class="lg:w-[65%]">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-10">
          {
            categories.map(([key, items]) => (
              <div>
                <h3 class="text-[0.625rem] sm:text-[0.6875rem] font-medium tracking-[0.08em] uppercase text-[#7a7a85] mb-3 flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#f97316]/50"></span>
                  {t(lang, key)}
                </h3>
                <div class="flex flex-wrap gap-2">
                  {items.map((skill) => (
                    <Tag label={skill} mono={true} icon={getSkillIcon(skill)} />
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
