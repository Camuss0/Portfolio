---
import type { Personal } from "../../types/data";
import { t, type Lang } from "../../i18n/ui";
export interface Props {
  personalEs: Personal;
  personalEn: Personal;
  lang: Lang;
}
const { personalEs, personalEn, lang } = Astro.props;
const personal = lang === "en" ? personalEn : personalEs;
const marqueeJSON = JSON.stringify({ es: personalEs.specialties, en: personalEn.specialties });
---

<section class="relative min-h-[100dvh] flex items-center justify-center overflow-hidden pt-16 hero-section">
  <canvas id="dot-canvas" class="absolute inset-0 w-full h-full" style="background: #000;"></canvas>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center justify-between">
      <!-- Text Content - ES -->
      <div id="hero-text-es" class="relative flex-1 lg:max-w-[60%]">
        <div class="text-center lg:text-left">
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-medium text-[#f4f4f5] leading-[1.05] -tracking-[0.03em] text-balance font-feature-ss mb-6">
            {personalEs.name}
          </h1>
          <p class="text-lg sm:text-xl text-[#a1a1aa] leading-[1.6] max-w-[55ch] mx-auto lg:mx-0 mb-4 text-balance">
            {personalEs.short_bio}
          </p>
          <p class="text-[0.9375rem] text-[#71717a] font-medium mb-10">
            {personalEs.location}
          </p>
          <div class="flex flex-wrap gap-3 justify-center lg:justify-start mb-12">
            <a href="#projects" class="inline-flex items-center gap-2 px-6 py-3 bg-[#f4f4f5] text-[#0a0a0b] rounded-full text-[0.875rem] font-semibold hover:bg-[#e4e4e5] transition-all duration-300 no-underline group">
              {t("es", "cta.projects")}
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="#experience" class="inline-flex items-center gap-2 px-6 py-3 border border-[#2e2e33] text-[#a1a1aa] rounded-full text-[0.875rem] font-semibold hover:border-[#fbbf24]/30 hover:text-[#f4f4f5] transition-all duration-300 no-underline">
              {t("es", "cta.about")}
            </a>
          </div>
        </div>
      </div>

      <!-- Text Content - EN -->
      <div id="hero-text-en" class="relative flex-1 lg:max-w-[60%]" style="display: none">
        <div class="text-center lg:text-left">
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-medium text-[#f4f4f5] leading-[1.05] -tracking-[0.03em] text-balance font-feature-ss mb-6">
            {personalEn.name}
          </h1>
          <p class="text-lg sm:text-xl text-[#a1a1aa] leading-[1.6] max-w-[55ch] mx-auto lg:mx-0 mb-4 text-balance">
            {personalEn.short_bio}
          </p>
          <p class="text-[0.9375rem] text-[#71717a] font-medium mb-10">
            {personalEn.location}
          </p>
          <div class="flex flex-wrap gap-3 justify-center lg:justify-start mb-12">
            <a href="#projects" class="inline-flex items-center gap-2 px-6 py-3 bg-[#f4f4f5] text-[#0a0a0b] rounded-full text-[0.875rem] font-semibold hover:bg-[#e4e4e5] transition-all duration-300 no-underline group">
              {t("en", "cta.projects")}
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="#experience" class="inline-flex items-center gap-2 px-6 py-3 border border-[#2e2e33] text-[#a1a1aa] rounded-full text-[0.875rem] font-semibold hover:border-[#fbbf24]/30 hover:text-[#f4f4f5] transition-all duration-300 no-underline">
              {t("en", "cta.about")}
            </a>
          </div>
        </div>
      </div>

      <!-- Photo Carousel -->
      <div class="flex-shrink-0 w-full max-w-[320px] lg:max-w-[380px]">
        <div class="relative">
          <div class="absolute -inset-4 bg-gradient-to-br from-[#fbbf24]/10 via-transparent to-[#fbbf24]/5 rounded-2xl blur-2xl"></div>
          <div class="relative aspect-[4/5]">
            <div id="photo-stack" class="relative w-full h-full">
              <div class="photo-card absolute inset-0 rounded-2xl overflow-hidden border border-[#1f1f22] glow-subtle flex items-center justify-center" style="background: linear-gradient(135deg, #1a1a2e, #16213e); z-index: 3; transform: rotate(0deg); transform-origin: bottom left;">
                <span class="text-[#2e2e33] text-sm font-mono tracking-wider opacity-60">01</span>
              </div>
              <div class="photo-card absolute inset-0 rounded-2xl overflow-hidden border border-[#1f1f22] glow-subtle flex items-center justify-center" style="background: linear-gradient(135deg, #1e1a2e, #2e1620); z-index: 2; transform: rotate(7deg); transform-origin: bottom left;">
                <span class="text-[#2e2e33] text-sm font-mono tracking-wider opacity-60">02</span>
              </div>
              <div class="photo-card absolute inset-0 rounded-2xl overflow-hidden border border-[#1f1f22] glow-subtle flex items-center justify-center" style="background: linear-gradient(135deg, #0f1a1e, #16201a); z-index: 1; transform: rotate(14deg); transform-origin: bottom left;">
                <span class="text-[#2e2e33] text-sm font-mono tracking-wider opacity-60">03</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar: scroll indicator + marquee -->
  <div class="absolute bottom-0 left-0 right-0 z-10 flex flex-col items-center">
    <!-- Basketball Scroll Indicator -->
    <div id="scroll-ball" class="flex items-start pt-10 cursor-pointer">
      <div class="flex flex-col items-center bg-[#15161a] hover:bg-[#1e1f26] rounded-t-full border-t-2 border-l-2 border-r-2 border-orange-500/50 hover:border-orange-500/70 px-4 pt-4 pb-1 transition-colors duration-300">
        <div id="basketball" class="ball-dribble relative">
          <svg width="36" height="36" viewBox="0 0 100 100" class="block drop-shadow-md ball-svg">
            <defs>
              <radialGradient id="ballGrad" cx="35%" cy="30%" r="68%">
                <stop offset="0%" stop-color="#f59e0b"/>
                <stop offset="25%" stop-color="#d97706"/>
                <stop offset="65%" stop-color="#c2410c"/>
                <stop offset="100%" stop-color="#7c2d12"/>
              </radialGradient>
            </defs>
            <circle cx="50" cy="50" r="47" fill="url(#ballGrad)" stroke="#451a03" stroke-width="1.5"/>
            <path d="M3 50 Q50 44 97 50" fill="none" stroke="#451a03" stroke-width="4.5" stroke-linecap="round"/>
            <path d="M50 3 Q44 50 50 97" fill="none" stroke="#451a03" stroke-width="4.5" stroke-linecap="round"/>
            <path d="M21 15 Q50 28 79 15" fill="none" stroke="#451a03" stroke-width="3" stroke-linecap="round"/>
            <path d="M21 85 Q50 72 79 85" fill="none" stroke="#451a03" stroke-width="3" stroke-linecap="round"/>
            <ellipse class="ball-highlight" cx="32" cy="28" rx="14" ry="9" fill="rgba(255,255,255,0.1)" transform="rotate(-18, 32, 28)"/>
          </svg>
        </div>
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none" class="text-orange-500/40 mt-5">
          <path d="M1 1l6 7 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div id="ball-shadow" class="shadow-pulse w-7 h-[6px] rounded-full" style="background: rgba(0,0,0,0.85); margin-top: 6px;"></div>
      </div>
    </div>

    <!-- Marquee -->
    <div class="w-full border-t border-b border-[#1f1f22]/40 bg-[#0a0a0b]/60 backdrop-blur-sm overflow-hidden py-4">
      <div id="marquee-wrapper" class="flex" style="width: max-content; will-change: transform;">
        <div class="marquee-group marquee-items">
          {personal.specialties.map((specialty) => (
            <span class="inline-flex items-center text-[0.8125rem] text-[#71717a] font-mono whitespace-nowrap">
              <span class="w-1 h-1 rounded-full bg-[#fbbf24]/40 mr-3"></span>
              {specialty}
            </span>
          ))}
        </div>
        <div class="marquee-group marquee-items" aria-hidden="true">
          {personal.specialties.map((specialty) => (
            <span class="inline-flex items-center text-[0.8125rem] text-[#71717a] font-mono whitespace-nowrap">
              <span class="w-1 h-1 rounded-full bg-[#fbbf24]/40 mr-3"></span>
              {specialty}
            </span>
          ))}
        </div>
        <div class="marquee-group marquee-items" aria-hidden="true">
          {personal.specialties.map((specialty) => (
            <span class="inline-flex items-center text-[0.8125rem] text-[#71717a] font-mono whitespace-nowrap">
              <span class="w-1 h-1 rounded-full bg-[#fbbf24]/40 mr-3"></span>
              {specialty}
            </span>
          ))}
        </div>
      </div>
    </div>

    <div id="marquee-data" hidden>{marqueeJSON}</div>
  </div>
</section>

<script is:inline>
  (function() {
    var CFG = {
      spacing: 16, radius: 1.3, baseAlpha: 0.25,
      drift: 2.9, motionRadius: 22, motionSpeed: 0.0144, ease: 0.1, returnEase: 0.01,
      influence: 350, darkness: 0.6, darknessRadius: 380, falloff: 3.4, mousePush: 20,
      color1: "#0055ff", color2: "#00ff91", waveSpeed: 0.00175
    };

    var canvas = document.getElementById('dot-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var w = 0, h = 0, dpr = 1, dots = [];
    var mouse = { x: -9999, y: -9999 };
    var lastCX = -9999, lastCY = -9999;

    function hex(h) { if (!h||h[0]!=="#") h="#0055ff"; return {r:parseInt(h.slice(1,3),16),g:parseInt(h.slice(3,5),16),b:parseInt(h.slice(5,7),16)}; }
    function lerp(a,b,t){ return a+(b-a)*t; }
    function lr(c1,c2,t){ return {r:Math.round(lerp(c1.r,c2.r,t)),g:Math.round(lerp(c1.g,c2.g,t)),b:Math.round(lerp(c1.b,c2.b,t))}; }
    function clamp(v,mn,mx){ return Math.max(mn,Math.min(mx,v)); }

    function resize() {
      dpr = Math.min(window.devicePixelRatio||1,2);
      var r = canvas.getBoundingClientRect();
      w = r.width; h = r.height;
      canvas.width = Math.floor(w*dpr); canvas.height = Math.floor(h*dpr);
      canvas.style.width = w+"px"; canvas.style.height = h+"px";
      ctx.setTransform(dpr,0,0,dpr,0,0);
      build();
    }

    function build() {
      dots = [];
      var sp = CFG.spacing, cols = Math.ceil(w/sp)+2, rows = Math.ceil(h/sp)+2;
      var ox = (w-(cols-1)*sp)*0.5, oy = (h-(rows-1)*sp)*0.5;
      for (var y=0; y<rows; y++) for (var x=0; x<cols; x++)
        dots.push({ox:ox+x*sp, oy:oy+y*sp, x:ox+x*sp, y:oy+y*sp, tx:ox+x*sp, ty:oy+y*sp, phase:Math.random()*Math.PI*2});
    }

    function animate(t) {
      ctx.fillStyle="#000"; ctx.fillRect(0,0,w,h);
      var c1=hex(CFG.color1), c2=hex(CFG.color2);

      for (var i=0; i<dots.length; i++) {
        var dot = dots[i];
        var dx = dot.ox-mouse.x, dy = dot.oy-mouse.y, dist = Math.hypot(dx,dy);
        var p = clamp(1-dist/CFG.influence,0,1);
        var shaped = Math.pow(p, CFG.falloff);

        var fX = (Math.sin(t*CFG.motionSpeed+dot.oy*0.008+dot.phase)*CFG.drift + Math.sin(t*0.0018+dot.ox*0.0035+dot.phase*1.7)*CFG.motionRadius) * p * 0.12;
        var fY = (Math.cos(t*CFG.motionSpeed+dot.ox*0.007+dot.phase)*CFG.drift + Math.cos(t*0.0016+dot.oy*0.003+dot.phase*1.4)*CFG.motionRadius) * p * 0.12;
        var push = p * CFG.mousePush;
        dot.tx = dot.ox + fX + (dx===0?0:dx/dist)*push;
        dot.ty = dot.oy + fY + (dy===0?0:dy/dist)*push;

        var atO = Math.abs(dot.tx-dot.ox)<0.5 && Math.abs(dot.ty-dot.oy)<0.5;
        var displ = Math.abs(dot.x-dot.ox)>1 || Math.abs(dot.y-dot.oy)>1;
        var e = (atO&&displ) ? CFG.returnEase : CFG.ease;
        dot.x += (dot.tx-dot.x)*e; dot.y += (dot.ty-dot.y)*e;

        var mix = 0.5+0.5*Math.sin(t*CFG.waveSpeed+dot.ox*0.005+dot.oy*0.003+dot.phase);
        var col = lr(c1,c2,mix);
        var dp = clamp(1-dist/CFG.darknessRadius,0,1);
        var dark = clamp(1-Math.pow(dp,CFG.falloff)*CFG.darkness,0,1);
        var rad = CFG.radius*(1+p*0.22);

        ctx.beginPath(); ctx.arc(dot.x,dot.y,rad,0,Math.PI*2);
        ctx.fillStyle = "rgba("+Math.round(col.r*dark)+","+Math.round(col.g*dark)+","+Math.round(col.b*dark)+","+CFG.baseAlpha+")";
        ctx.fill();
      }
      requestAnimationFrame(animate);
    }

    function updateMouse(cx,cy){lastCX=cx;lastCY=cy;var r=canvas.getBoundingClientRect();mouse.x=cx-r.left;mouse.y=cy-r.top;}
    window.addEventListener("mousemove",function(e){updateMouse(e.clientX,e.clientY);},{passive:true});
    window.addEventListener("mouseleave",function(){mouse.x=-9999;mouse.y=-9999;});
    window.addEventListener("touchmove",function(e){if(e.touches.length){updateMouse(e.touches[0].clientX,e.touches[0].clientY);}},{passive:true});
    window.addEventListener("scroll",function(){if(lastCX>-9998){var r=canvas.getBoundingClientRect();mouse.x=lastCX-r.left;mouse.y=lastCY-r.top;}});
    window.addEventListener("resize",resize);
    resize();
    requestAnimationFrame(animate);
  })();
</script>

<script is:inline>
  (function() {
    var wrapper = document.getElementById('marquee-wrapper');
    if (!wrapper) return;
    var group = wrapper.querySelector('.marquee-group');
    if (!group) return;
    var pos = 0;
    var lastTime = performance.now();
    var speed = 40;
    var groupWidth = group.offsetWidth;
    var lastRecalc = 0;

    function recalc() {
      var w = group.offsetWidth;
      if (w !== groupWidth && w > 0) {
        var ratio = w / groupWidth;
        pos = pos * ratio;
        groupWidth = w;
      }
    }

    function tick(now) {
      var dt = (now - lastTime) / 1000;
      if (dt > 0.5) dt = 0.016;
      lastTime = now;
      pos -= speed * dt;

      if (pos <= -groupWidth) {
        pos += groupWidth;
        if (pos <= -groupWidth) pos += groupWidth;
      }

      wrapper.style.transform = 'translate3d(' + Math.round(pos) + 'px, 0, 0)';

      if (now - lastRecalc > 2000) {
        recalc();
        lastRecalc = now;
      }

      requestAnimationFrame(tick);
    }

    window.addEventListener('resize', recalc);
    requestAnimationFrame(tick);
  })();
</script>

<script is:inline>
  (function () {
    var ball = document.getElementById('scroll-ball');
    if (!ball) return;
    ball.addEventListener('click', function () {
      var esSec = document.getElementById('projects');
      if (!esSec) return;
      var esParent = document.getElementById('lang-es');
      var enParent = document.getElementById('lang-en');
      var idx = 0; while (idx < esParent.children.length && esParent.children[idx] !== esSec) idx++;
      var visible = enParent.style.display !== 'none' ? enParent : esParent;
      var target = visible.children[idx] || esSec;
      target.scrollIntoView({ behavior: 'smooth' });
    });
  })();
</script>

<script is:inline>
  (function() {
    var stack = document.getElementById('photo-stack');
    if (!stack) return;
    var cards = Array.from(stack.querySelectorAll('.photo-card'));
    if (cards.length < 2) return;

    var angles = [0, 7, 14];
    var zValues = [3, 2, 1];
    var interval = 5000;
    var rotating = false;

    function sync() {
      for (var i = 0; i < cards.length; i++) {
        cards[i].style.transform = 'rotate(' + angles[i] + 'deg)';
        cards[i].style.zIndex = zValues[i];
      }
    }

    function cycle() {
      if (rotating) return;
      rotating = true;

      var lastAngle = angles.pop();
      angles.unshift(lastAngle);
      var lastZ = zValues.pop();
      zValues.unshift(lastZ);

      for (var i = 0; i < cards.length; i++) {
        cards[i].style.transition = 'transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1)';
        cards[i].style.transform = 'rotate(' + angles[i] + 'deg)';
        cards[i].style.zIndex = zValues[i];
      }

      setTimeout(function() {
        for (var i = 0; i < cards.length; i++) {
          cards[i].style.transition = '';
        }
        rotating = false;
      }, 900);
    }

    sync();
    setInterval(cycle, interval);
  })();
</script>

<style>
  @font-face {
    font-family: 'Google Sans Flex';
    src: url('/fonts/GoogleSansFlex.ttf') format('truetype');
    font-weight: 100 900;
    font-stretch: 50% 200%;
    font-display: swap;
  }
  .hero-section {
    font-family: 'Google Sans Flex', 'Inter', system-ui, sans-serif;
  }
  .hero-section h1 {
    font-family: 'Google Sans Flex', 'Inter', system-ui, sans-serif;
  }
</style>
