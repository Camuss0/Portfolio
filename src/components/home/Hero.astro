---
import type { Personal } from "../../types/data";
import { t, type Lang } from "../../i18n/ui";
import SimpleCardStack from "../ui/SimpleCardStack.astro";
export interface Props {
  personalEs: Personal;
  personalEn: Personal;
  lang: Lang;
}
const { personalEs, personalEn, lang } = Astro.props;
const personal = lang === "en" ? personalEn : personalEs;
---

<section class="relative min-h-[100dvh] flex items-center justify-center overflow-hidden pt-20 sm:pt-16 hero-section">
  <canvas id="dot-canvas" class="absolute inset-0 w-full h-full" style="background: #000;"></canvas>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 w-full -mt-12 sm:-mt-14 lg:-mt-18">
    <div class="flex flex-col lg:flex-row gap-8 sm:gap-12 lg:gap-20 items-center justify-between">
      <div class="flex-1 lg:max-w-[60%]">
        <div class="text-center lg:text-left">
          <!-- ES text block -->
          <div id="hero-text-es">
            <h1 class="sr-only">Valentin Camusso — Full Stack Developer</h1>
            <div class="reveal" style="transition-delay: 0ms;">
              <div class="overflow-hidden">
              <svg viewBox="0 0 1000 290" class="w-[88%] sm:w-[92%] md:w-full mx-auto lg:mx-0 block overflow-visible">
                <defs>
                  <linearGradient id="nameGradEs" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#172de2"/>
                    <stop offset="100%" stop-color="#00aaff"/>
                  </linearGradient>
                  <filter id="cleanStrokeEs" x="-20%" y="-20%" width="140%" height="140%">
                    <feMorphology in="SourceGraphic" operator="dilate" radius="4" result="dilated"/>
                    <feComposite in="dilated" in2="SourceGraphic" operator="out"/>
                  </filter>
                </defs>
                <text x="500" y="230" fill="url(#nameGradEs)" filter="url(#cleanStrokeEs)" font-family="'Inter', system-ui, sans-serif" font-weight="700" font-size="260" text-anchor="middle" class="hero-svg-text lg:hidden">Valentin</text>
                <text x="0" y="230" fill="url(#nameGradEs)" filter="url(#cleanStrokeEs)" font-family="'Inter', system-ui, sans-serif" font-weight="700" font-size="220" class="hero-svg-text hidden lg:block">Valentin</text>
              </svg>
              </div>
            </div>
            <h2 class="reveal text-[#f4f4f5] text-[clamp(5rem,17vw,9.5rem)] font-bold leading-[1.05] -tracking-[0.03em]" style="font-family: 'Inter', system-ui, sans-serif; transition-delay: 100ms;">Camusso</h2>
            <div class="flex flex-wrap gap-2 mt-6 sm:mt-8 justify-center lg:justify-start max-w-[520px]">
              {personalEs.specialties.map((s, i) => (
                <span class="reveal px-3 py-1 sm:px-4 sm:py-1.5 rounded-full text-[0.6875rem] sm:text-[0.8125rem] text-[#a1a1aa] border border-[#3f3f46]/70 bg-[#111113]/60" style={`transition-delay: ${250 + i * 60}ms`}>{s}</span>
              ))}
            </div>
            <div class="reveal flex flex-wrap gap-3 mt-8 justify-center lg:justify-start" style="transition-delay: 400ms;">
              <a href="#projects" class="flex-1 sm:flex-none justify-center inline-flex items-center gap-2 px-5 sm:px-6 py-3 bg-[#172de2] text-white rounded-full text-[0.8125rem] sm:text-[0.875rem] font-semibold hover:bg-[#1324c0] transition-all duration-300 no-underline group">
                {t("es", "cta.projects")}
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
              <a href="#contact" class="flex-1 sm:flex-none justify-center inline-flex items-center gap-2 px-6 py-3 border border-[#2e2e33] text-[#a1a1aa] rounded-full text-[0.8125rem] sm:text-[0.875rem] font-semibold hover:border-[#f97316]/30 hover:text-[#f4f4f5] transition-all duration-300 no-underline">
                {t("es", "cta.contact")}
              </a>
            </div>
          </div>

          <!-- EN text block -->
          <div id="hero-text-en" style="display: none">
            <h1 class="sr-only">Valentin Camusso — Full Stack Developer</h1>
            <div class="reveal" style="transition-delay: 0ms;">
              <div class="overflow-hidden">
              <svg viewBox="0 0 1000 290" class="w-[88%] sm:w-[92%] md:w-full mx-auto lg:mx-0 block overflow-visible">
                <defs>
                  <linearGradient id="nameGradEn" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#172de2"/>
                    <stop offset="100%" stop-color="#00aaff"/>
                  </linearGradient>
                  <filter id="cleanStrokeEn" x="-20%" y="-20%" width="140%" height="140%">
                    <feMorphology in="SourceGraphic" operator="dilate" radius="4" result="dilated"/>
                    <feComposite in="dilated" in2="SourceGraphic" operator="out"/>
                  </filter>
                </defs>
                <text x="500" y="230" fill="url(#nameGradEn)" filter="url(#cleanStrokeEn)" font-family="'Inter', system-ui, sans-serif" font-weight="700" font-size="260" text-anchor="middle" class="hero-svg-text lg:hidden">Valentin</text>
                <text x="0" y="230" fill="url(#nameGradEn)" filter="url(#cleanStrokeEn)" font-family="'Inter', system-ui, sans-serif" font-weight="700" font-size="220" class="hero-svg-text hidden lg:block">Valentin</text>
              </svg>
              </div>
            </div>
            <h2 class="reveal text-[#f4f4f5] text-[clamp(5rem,17vw,9.5rem)] font-bold leading-[1.05] -tracking-[0.03em]" style="font-family: 'Inter', system-ui, sans-serif; transition-delay: 100ms;">Camusso</h2>
            <div class="flex flex-wrap gap-2 mt-6 sm:mt-8 justify-center lg:justify-start max-w-[520px]">
              {personalEn.specialties.map((s, i) => (
                <span class="reveal px-3 py-1 sm:px-4 sm:py-1.5 rounded-full text-[0.6875rem] sm:text-[0.8125rem] text-[#a1a1aa] border border-[#3f3f46]/70 bg-[#111113]/60" style={`transition-delay: ${250 + i * 60}ms`}>{s}</span>
              ))}
            </div>
            <div class="reveal flex flex-wrap gap-3 mt-8 justify-center lg:justify-start" style="transition-delay: 400ms;">
              <a href="#projects" class="flex-1 sm:flex-none justify-center inline-flex items-center gap-2 px-5 sm:px-6 py-3 bg-[#172de2] text-white rounded-full text-[0.8125rem] sm:text-[0.875rem] font-semibold hover:bg-[#1324c0] transition-all duration-300 no-underline group">
                {t("en", "cta.projects")}
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
              <a href="#contact" class="flex-1 sm:flex-none justify-center inline-flex items-center gap-2 px-6 py-3 border border-[#2e2e33] text-[#a1a1aa] rounded-full text-[0.8125rem] sm:text-[0.875rem] font-semibold hover:border-[#f97316]/30 hover:text-[#f4f4f5] transition-all duration-300 no-underline">
                {t("en", "cta.contact")}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Photo Card Stack -->
      <div class="reveal-right flex-shrink-0 w-full max-w-[280px] sm:max-w-[360px] lg:max-w-[460px]" style="transition-delay: 150ms;">
        <SimpleCardStack />
      </div>
    </div>
  </div>

  <!-- Bottom bar: scroll indicator -->
  <div class="absolute bottom-0 left-0 right-0 z-10 flex flex-col items-center">
    <!-- Basketball Scroll Indicator -->
    <div id="scroll-ball" class="hero-reveal-up flex items-start pt-10 cursor-pointer" style="animation-delay: 500ms;">
      <div class="flex flex-col items-center bg-[#15161a] hover:bg-[#1e1f26] rounded-t-full border-t-2 border-l-2 border-r-2 border-orange-500/50 hover:border-orange-500/70 px-4 pt-4 pb-1 transition-colors duration-300">
        <div id="basketball" class="ball-dribble relative">
          <svg width="36" height="36" viewBox="0 0 100 100" class="block drop-shadow-md ball-svg">
            <defs>
              <radialGradient id="ballGrad" cx="35%" cy="30%" r="68%">
                <stop offset="0%" stop-color="#f59e0b"/>
                <stop offset="25%" stop-color="#d97706"/>
                <stop offset="65%" stop-color="#c2410c"/>
                <stop offset="100%" stop-color="#7c2d12"/>
              </radialGradient>
            </defs>
            <circle cx="50" cy="50" r="47" fill="url(#ballGrad)" stroke="#451a03" stroke-width="1.5"/>
            <path d="M3 50 Q50 44 97 50" fill="none" stroke="#451a03" stroke-width="4.5" stroke-linecap="round"/>
            <path d="M50 3 Q44 50 50 97" fill="none" stroke="#451a03" stroke-width="4.5" stroke-linecap="round"/>
            <path d="M21 15 Q50 28 79 15" fill="none" stroke="#451a03" stroke-width="3" stroke-linecap="round"/>
            <path d="M21 85 Q50 72 79 85" fill="none" stroke="#451a03" stroke-width="3" stroke-linecap="round"/>
            <ellipse class="ball-highlight" cx="32" cy="28" rx="14" ry="9" fill="rgba(255,255,255,0.1)" transform="rotate(-18, 32, 28)"/>
          </svg>
        </div>
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none" class="text-orange-500/40 mt-5">
          <path d="M1 1l6 7 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div id="ball-shadow" class="shadow-pulse w-7 h-[6px] rounded-full" style="background: rgba(0,0,0,0.85); margin-top: 6px;"></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    var CFG = {
      spacing: 16, radius: 1.45, baseAlpha: 0.35,
      drift: 2.9, motionRadius: 22, motionSpeed: 0.0144, ease: 0.04, returnEase: 0.03,
      influence: 350, darkness: 0.6, darknessRadius: 380, falloff: 3.4, mousePush: 20,
      color1: "#172de2", color2: "#00aaff", waveSpeed: 0.00175
    };

    var canvas = document.getElementById('dot-canvas');
    if (!canvas) return;
    var TOP_OFFSET = 10;
    var ctx = canvas.getContext('2d');
    var w = 0, h = 0, dpr = 1, dots = [];
    var mouse = { x: -9999, y: -9999 };
    var lastCX = -9999, lastCY = -9999;

    function hex(h) { if (!h||h[0]!=="#") h="#172de2"; return {r:parseInt(h.slice(1,3),16),g:parseInt(h.slice(3,5),16),b:parseInt(h.slice(5,7),16)}; }
    function lerp(a,b,t){ return a+(b-a)*t; }
    function lr(c1,c2,t){ return {r:Math.round(lerp(c1.r,c2.r,t)),g:Math.round(lerp(c1.g,c2.g,t)),b:Math.round(lerp(c1.b,c2.b,t))}; }
    function clamp(v,mn,mx){ return Math.max(mn,Math.min(mx,v)); }

    function resize() {
      dpr = Math.min(window.devicePixelRatio||1,2);
      var r = canvas.getBoundingClientRect();
      w = r.width; h = r.height;
      if (w < 1 || h < 1) return;
      canvas.width = Math.floor(w*dpr); canvas.height = Math.floor(h*dpr);
      ctx.setTransform(dpr,0,0,dpr,0,0);
      build();
    }

    function build() {
      dots = [];
      var sp = CFG.spacing, cols = Math.ceil(w/sp)+2, rows = Math.ceil(h/sp)+2;
      var ox = (w-(cols-1)*sp)*0.5, oy = TOP_OFFSET+(h-TOP_OFFSET-(rows-1)*sp)*0.5;
      for (var y=0; y<rows; y++) for (var x=0; x<cols; x++)
        dots.push({ox:ox+x*sp, oy:oy+y*sp, x:ox+x*sp, y:oy+y*sp, tx:ox+x*sp, ty:oy+y*sp, phase:Math.random()*Math.PI*2});
    }

    function animate(t) {
      ctx.fillStyle="#000"; ctx.fillRect(0,0,w,h);
      var c1=hex(CFG.color1), c2=hex(CFG.color2);

      for (var i=0; i<dots.length; i++) {
        var dot = dots[i];
        var dx = dot.ox-mouse.x, dy = dot.oy-mouse.y, dist = Math.hypot(dx,dy);
        var p = clamp(1-dist/CFG.influence,0,1);
        var shaped = Math.pow(p, CFG.falloff);

        var fX = (Math.sin(t*CFG.motionSpeed+dot.oy*0.008+dot.phase)*CFG.drift + Math.sin(t*0.0018+dot.ox*0.0035+dot.phase*1.7)*CFG.motionRadius) * p * 0.12;
        var fY = (Math.cos(t*CFG.motionSpeed+dot.ox*0.007+dot.phase)*CFG.drift + Math.cos(t*0.0016+dot.oy*0.003+dot.phase*1.4)*CFG.motionRadius) * p * 0.12;
        var push = p * CFG.mousePush;
        dot.tx = dot.ox + fX + (dx===0?0:dx/dist)*push;
        dot.ty = dot.oy + fY + (dy===0?0:dy/dist)*push;

        var atO = Math.abs(dot.tx-dot.ox)<0.5 && Math.abs(dot.ty-dot.oy)<0.5;
        var displ = Math.abs(dot.x-dot.ox)>1 || Math.abs(dot.y-dot.oy)>1;
        var e = (atO&&displ) ? CFG.returnEase : CFG.ease;
        dot.x += (dot.tx-dot.x)*e; dot.y += (dot.ty-dot.y)*e;

        var mix = 0.5+0.5*Math.sin(t*CFG.waveSpeed+dot.ox*0.005+dot.oy*0.003+dot.phase);
        var col = lr(c1,c2,mix);
        var dp = clamp(1-dist/CFG.darknessRadius,0,1);
        var dark = clamp(1-Math.pow(dp,CFG.falloff)*CFG.darkness,0,1);
        var rad = CFG.radius*(1+p*0.22);

        ctx.beginPath(); ctx.arc(dot.x,dot.y,rad,0,Math.PI*2);
        ctx.fillStyle = "rgba("+Math.round(col.r*dark)+","+Math.round(col.g*dark)+","+Math.round(col.b*dark)+","+CFG.baseAlpha+")";
        ctx.fill();
      }
      requestAnimationFrame(animate);
    }

    function updateMouse(cx,cy){lastCX=cx;lastCY=cy;var r=canvas.getBoundingClientRect();mouse.x=cx-r.left;mouse.y=cy-r.top;}
    window.addEventListener("mousemove",function(e){updateMouse(e.clientX,e.clientY);},{passive:true});
    window.addEventListener("mouseleave",function(){mouse.x=-9999;mouse.y=-9999;});
    window.addEventListener("touchmove",function(e){if(e.touches.length){updateMouse(e.touches[0].clientX,e.touches[0].clientY);}},{passive:true});
    window.addEventListener("scroll",function(){if(lastCX>-9998){var r=canvas.getBoundingClientRect();mouse.x=lastCX-r.left;mouse.y=lastCY-r.top;}});
    new ResizeObserver(resize).observe(canvas);
    resize();
    requestAnimationFrame(animate);
  })();
</script>

<script is:inline>
  (function () {
    var ball = document.getElementById('scroll-ball');
    if (!ball) return;
    ball.addEventListener('click', function () {
      var esSec = document.getElementById('projects');
      if (!esSec) return;
      var esParent = document.getElementById('lang-es');
      var enParent = document.getElementById('lang-en');
      var idx = 0; while (idx < esParent.children.length && esParent.children[idx] !== esSec) idx++;
      var visible = enParent.style.display !== 'none' ? enParent : esParent;
      var target = visible.children[idx] || esSec;
      target.scrollIntoView({ behavior: 'smooth' });
    });
  })();
</script>



<style>
  .hero-section {
    font-family: 'Inter', system-ui, sans-serif;
  }

  @keyframes hero-reveal-up {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-reveal-up {
    opacity: 0;
    animation: hero-reveal-up 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
