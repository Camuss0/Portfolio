---
import type { Personal } from "../../types/data";
export interface Props {
  personal: Personal;
}
const { personal } = Astro.props;

// Double the specialties for seamless marquee
const marqueeItems = [...personal.specialties, ...personal.specialties, ...personal.specialties];
---

<section class="relative min-h-[100dvh] flex items-center justify-center overflow-hidden pt-16">
  <!-- Dot Canvas Background -->
  <canvas id="dot-canvas" class="absolute inset-0 w-full h-full"></canvas>

  <!-- Gradient overlay for depth -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#0a0a0b] z-[1] pointer-events-none"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center justify-between">
      <!-- Text Content -->
      <div class="flex-1 lg:max-w-[60%] text-center lg:text-left">
        <!-- Label -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#111113] border border-[#1f1f22] mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-[#fbbf24] animate-pulse"></span>
          <span class="text-[0.6875rem] text-[#71717a] font-medium tracking-wide">{personal.role}</span>
        </div>

        <!-- Name -->
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-[#f4f4f5] leading-[1.05] -tracking-[0.03em] text-balance font-feature-ss mb-6">
          {personal.name}
        </h1>

        <!-- Statement -->
        <p class="text-lg sm:text-xl text-[#a1a1aa] leading-[1.6] max-w-[55ch] mx-auto lg:mx-0 mb-4 text-balance">
          {personal.short_bio}
        </p>

        <!-- Location -->
        <p class="text-[0.9375rem] text-[#52525b] font-medium mb-10">
          {personal.location}
        </p>

        <!-- CTA -->
        <div class="flex flex-wrap gap-3 justify-center lg:justify-start mb-12">
          <a href="#projects" class="inline-flex items-center gap-2 px-6 py-3 bg-[#f4f4f5] text-[#0a0a0b] rounded-full text-[0.875rem] font-semibold hover:bg-[#e4e4e5] transition-all duration-300 no-underline group">
            View Projects
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="#experience" class="inline-flex items-center gap-2 px-6 py-3 border border-[#2e2e33] text-[#a1a1aa] rounded-full text-[0.875rem] font-semibold hover:border-[#fbbf24]/30 hover:text-[#f4f4f5] transition-all duration-300 no-underline">
            About Me
          </a>
        </div>
      </div>

      <!-- Photo -->
      <div class="flex-shrink-0 w-full max-w-[320px] lg:max-w-[380px]">
        <div class="relative">
          <!-- Glow effect behind -->
          <div class="absolute -inset-4 bg-gradient-to-br from-[#fbbf24]/10 via-transparent to-[#fbbf24]/5 rounded-2xl blur-2xl"></div>
          <!-- Photo container -->
          <div class="relative aspect-[4/5] bg-[#111113] border border-[#1f1f22] rounded-2xl overflow-hidden glow-subtle">
            <img
              src="/images/personal/photo.webp"
              alt="Valentin Camusso"
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.parentElement.innerHTML += '<div class=\'w-full h-full flex items-center justify-center\'><span class=\'text-[#2e2e33] text-sm font-medium\'>Photo</span></div>'"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Marquee -->
  <div class="absolute bottom-0 left-0 right-0 z-10 border-t border-[#1f1f22]/40 bg-[#0a0a0b]/60 backdrop-blur-sm overflow-hidden py-4">
    <div class="flex animate-marquee whitespace-nowrap">
      {marqueeItems.map((specialty) => (
        <span class="inline-flex items-center mx-6 text-[0.8125rem] text-[#52525b] font-mono">
          <span class="w-1 h-1 rounded-full bg-[#fbbf24]/40 mr-3"></span>
          {specialty}
        </span>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    const canvas = document.getElementById('dot-canvas');
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    let width, height;
    let mouse = { x: -1000, y: -1000 };
    let dots = [];
    
    const DOT_SPACING = 40;
    const DOT_RADIUS = 1;
    const MOUSE_RADIUS = 150;
    const REPulsion_FORCE = 30;
    
    function resize() {
      width = canvas.offsetWidth;
      height = canvas.offsetHeight;
      canvas.width = width;
      canvas.height = height;
      initDots();
    }
    
    function initDots() {
      dots = [];
      const cols = Math.ceil(width / DOT_SPACING) + 1;
      const rows = Math.ceil(height / DOT_SPACING) + 1;
      
      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          dots.push({
            x: i * DOT_SPACING,
            y: j * DOT_SPACING,
            baseX: i * DOT_SPACING,
            baseY: j * DOT_SPACING,
            vx: 0,
            vy: 0
          });
        }
      }
    }
    
    function animate() {
      ctx.clearRect(0, 0, width, height);
      
      dots.forEach(dot => {
        // Calculate distance from mouse
        const dx = mouse.x - dot.x;
        const dy = mouse.y - dot.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        
        // Repulsion force
        if (dist < MOUSE_RADIUS && dist > 0) {
          const force = (MOUSE_RADIUS - dist) / MOUSE_RADIUS;
          const angle = Math.atan2(dy, dx);
          dot.vx -= Math.cos(angle) * force * REPulsion_FORCE * 0.5;
          dot.vy -= Math.sin(angle) * force * REPulsion_FORCE * 0.5;
        }
        
        // Spring back to base position
        dot.vx += (dot.baseX - dot.x) * 0.05;
        dot.vy += (dot.baseY - dot.y) * 0.05;
        
        // Damping
        dot.vx *= 0.9;
        dot.vy *= 0.9;
        
        // Update position
        dot.x += dot.vx;
        dot.y += dot.vy;
        
        // Calculate opacity based on distance from mouse
        const distFromBase = Math.sqrt(
          (dot.x - dot.baseX) ** 2 + (dot.y - dot.baseY) ** 2
        );
        const maxDist = 20;
        const opacity = 0.15 + Math.min(distFromBase / maxDist, 1) * 0.25;
        
        // Draw dot
        ctx.beginPath();
        ctx.arc(dot.x, dot.y, DOT_RADIUS, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 255, ${opacity})`;
        ctx.fill();
      });
      
      requestAnimationFrame(animate);
    }
    
    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });
    
    canvas.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });
    
    window.addEventListener('resize', resize);
    resize();
    animate();
  })();
</script>
