---
import type { Project } from "../../types/data";
import FeaturedProject from "./FeaturedProject.astro";
import ProjectCard from "./ProjectCard.astro";
import { t, type Lang } from "../../i18n/ui";
export interface Props {
  projects: Project[];
  lang: Lang;
}
const { projects, lang } = Astro.props;

const featuredIds = [
  "medical-management-platform",
  "aspros-diesel",
  "dynamic-forms-system",
];

const featured = featuredIds
  .map((id) => projects.find((p) => p.id === id))
  .filter((p): p is Project => !!p);

const compact = projects.filter((p) => !featuredIds.includes(p.id));
---

<section id="projects" class="py-16 sm:py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="mb-10 sm:mb-16 md:mb-20 reveal">
      <div class="w-6 h-[3px] bg-[#f97316] rounded-full mb-4"></div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[#f4f4f5] leading-[1.1] -tracking-[0.02em]">
        {t(lang, "section.projects")}
      </h2>
    </div>

    <!-- Featured Projects -->
    <div class="space-y-12 sm:space-y-16 md:space-y-24">
      {featured.map((p, i) => (
        <FeaturedProject project={p} index={i} lang={lang} />
      ))}
    </div>

    <!-- Compact Projects -->
    {
      compact.length > 0 && (
        <div class="mt-16 sm:mt-24 md:mt-32">
          <div class="flex items-center gap-4 mb-10 reveal">
            <span class="text-[0.6875rem] text-[#71717a] font-mono tracking-wider">{t(lang, "label.additional")}</span>
            <span class="flex-1 h-px bg-[#1f1f22]"></span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {compact.map((p) => (
              <ProjectCard project={p} lang={lang} />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
