---
import type { Project } from "../../types/data";
import Tag from "../ui/Tag.astro";
import { t, type Lang } from "../../i18n/ui";
import { getSkillIcon } from "../../utils/icons";
export interface Props {
  project: Project;
  index: number;
  lang: Lang;
  isLast?: boolean;
}
const { project, index, lang, isLast = false } = Astro.props;
const topFeatures = project.key_features.slice(0, 3);
const topStack = project.tech_stack.slice(0, 5);

// Alternate layout: even = image left, odd = image right
const isImageLeft = index % 2 === 0;
const revealClass = isImageLeft ? "reveal-left" : "reveal-right";
---

<button
  class={`group w-full text-left cursor-pointer block ${revealClass}`}
  data-project-id={project.id}
  data-open-modal=""
>
  <div class={`flex flex-col ${isImageLeft ? 'lg:flex-row' : 'lg:flex-row-reverse'} gap-4 sm:gap-8 lg:gap-16 items-center`}>
    <!-- Image Side -->
    <div class="flex-shrink-0 w-full lg:w-[52%]">
      <div class="relative overflow-hidden rounded-xl bg-[#111113] border border-[#1f1f22] aspect-[16/10] group-hover:border-[#2e2e33] transition-all duration-500">
        {
          project.screenshots.length > 0 ? (
            <img
              src={`/images/projects/${project.id}/${project.screenshots[0]}`}
              alt={project.name}
              class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500"
              loading="lazy"
            />
          ) : (
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-[#2e2e33] text-sm font-medium font-mono tracking-wider">&lt;{project.id}&gt;</span>
            </div>
          )
        }
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0b]/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
      </div>
    </div>

    <!-- Text Side -->
    <div class="flex-1 lg:max-w-[48%] px-2 sm:px-0">
      <!-- Row 1: number · type · [company → client] -->
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-6">
        <span class="text-[0.6875rem] text-[#f97316] font-mono tracking-wider">0{index + 1}</span>
        <span class="w-5 h-px bg-[#2e2e33]"></span>
        <span class="text-[0.6875rem] text-[#71717a] font-medium tracking-wide">{project.type}</span>
        {(project.company || project.client) && (
          <>
            <span class="hidden sm:inline text-[0.625rem] text-[#3f3f46] select-none" aria-hidden="true">&middot;</span>
            <span class="hidden sm:inline-flex items-center gap-1.5 text-[0.6875rem] bg-[#f97316]/10 border border-[#f97316]/20 px-3 py-1.5 rounded-full">
              {project.company && <span class="text-[#a1a1aa] font-mono">{t(lang, "badge.developed_at", { company: project.company })}</span>}
              {project.company && project.client && <span class="text-[#f97316] text-[0.625rem]">&rarr;</span>}
              {project.client && (
                <>
                  {project.client_logo && (
                    <img src={project.client_logo} alt={project.client ?? ""} class="w-4 h-4 rounded-full object-cover flex-shrink-0" />
                  )}
                  <span class="text-[#f4f4f5] font-medium">{project.client}</span>
                </>
              )}
            </span>
          </>
        )}
      </div>

      <h3 class="text-xl sm:text-2xl md:text-3xl lg:text-[2rem] font-bold text-[#f4f4f5] leading-[1.15] -tracking-[0.02em] mb-4 group-hover:text-[#f97316] transition-colors duration-500">
        {project.name}
      </h3>

      <p class="text-[0.8125rem] sm:text-[0.9375rem] text-[#a1a1aa] leading-[1.7] mb-6">
        {project.short_description}
      </p>

      {topFeatures.length > 0 && (
        <div class="hidden sm:flex flex-wrap gap-2 mb-6">
          {topFeatures.map((f) => (
            <span class="text-[0.625rem] sm:text-[0.6875rem] text-[#a1a1aa] bg-[#111113] border border-[#1f1f22] px-2.5 py-1 rounded-full font-mono">
              {f}
            </span>
          ))}
        </div>
      )}

      {topStack.length > 0 && (
        <div class="hidden sm:flex flex-wrap gap-2">
          {topStack.map((s) => <Tag label={s} mono={true} icon={getSkillIcon(s)} />)}
        </div>
      )}

      <!-- View Details link -->
      <div class="mt-8 flex items-center gap-2 text-[0.8125rem] text-[#71717a] group-hover:text-[#f97316] transition-colors duration-300">
        <span class="font-medium">{t(lang, "cta.viewDetails")}</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </div>
    </div>
  </div>

  <!-- Separator -->
  {!isLast && <div class="mt-10 sm:mt-16 lg:mt-24 h-px bg-gradient-to-r from-transparent via-[#1f1f22] to-transparent"></div>}
</button>
