---
import type { Project } from "../../types/data";
export interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const topFeatures = project.key_features.slice(0, 3);
const topStack = project.tech_stack.slice(0, 5);

// Alternate layout: even = image left, odd = image right
const isImageLeft = index % 2 === 0;
const revealClass = isImageLeft ? "reveal-left" : "reveal-right";
---

<button
  class={`group w-full text-left cursor-pointer block ${revealClass}`}
  data-project-id={project.id}
  data-open-modal=""
>
  <div class={`flex flex-col ${isImageLeft ? 'lg:flex-row' : 'lg:flex-row-reverse'} gap-8 lg:gap-16 items-center`}>
    <!-- Image Side -->
    <div class="flex-shrink-0 w-full lg:w-[52%]">
      <div class="relative overflow-hidden rounded-xl bg-[#111113] border border-[#1f1f22] aspect-[16/10] group-hover:border-[#2e2e33] transition-all duration-500">
        {project.screenshots_available ? (
          <img
            src={`/images/projects/${project.id}/01.webp`}
            alt={project.name}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
            onerror="this.style.display='none'"
          />
        ) : null}
        <div class={`absolute inset-0 flex items-center justify-center ${project.screenshots_available ? 'hidden' : 'block'}`}>
          <span class="text-[#2e2e33] text-sm font-medium font-mono tracking-wider">&lt;{project.id}&gt;</span>
        </div>
        <!-- Overlay gradient on hover -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0b]/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
      </div>
    </div>

    <!-- Text Side -->
    <div class="flex-1 lg:max-w-[48%]">
      <div class="flex items-center gap-3 mb-5">
        <span class="text-[0.6875rem] text-[#fbbf24] font-mono tracking-wider">0{index + 1}</span>
        <span class="w-8 h-px bg-[#2e2e33]"></span>
        <span class="text-[0.6875rem] text-[#71717a] font-medium tracking-wide">{project.type}</span>
      </div>

      <h3 class="text-2xl md:text-3xl lg:text-[2rem] font-bold text-[#f4f4f5] leading-[1.15] -tracking-[0.02em] mb-4 group-hover:text-[#fbbf24] transition-colors duration-500">
        {project.name}
      </h3>

      <p class="text-[0.9375rem] text-[#a1a1aa] leading-[1.7] mb-6">
        {project.short_description}
      </p>

      {topFeatures.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-6">
          {topFeatures.map((f) => (
            <span class="text-[0.6875rem] text-[#52525b] bg-[#111113] border border-[#1f1f22] px-2.5 py-1 rounded-full font-mono">
              {f}
            </span>
          ))}
        </div>
      )}

      {topStack.length > 0 && (
        <div class="flex flex-wrap gap-x-4 gap-y-1.5">
          {topStack.map((s) => (
            <span class="font-mono text-[0.75rem] text-[#52525b]">{s}</span>
          ))}
        </div>
      )}

      <!-- View Details link -->
      <div class="mt-8 flex items-center gap-2 text-[0.8125rem] text-[#71717a] group-hover:text-[#fbbf24] transition-colors duration-300">
        <span class="font-medium">View Details</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </div>
    </div>
  </div>

  <!-- Separator -->
  <div class="mt-16 lg:mt-24 h-px bg-gradient-to-r from-transparent via-[#1f1f22] to-transparent"></div>
</button>
