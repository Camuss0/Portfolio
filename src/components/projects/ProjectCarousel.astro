---
import { t, type Lang } from "../../i18n/ui";

export interface Props {
  projectId: string;
  screenshots: string[];
  lang: Lang;
}

const { projectId, screenshots, lang } = Astro.props;
const count = screenshots.length;
const images = screenshots.map((s) => `/images/projects/${projectId}/${s}`);
---

{
  count > 0 && (
    <div
      class="project-carousel lg:sticky lg:top-8 lg:self-start"
      data-project-id={projectId}
      data-images={JSON.stringify(images)}
      data-lang={lang}
    >
      <!-- Desktop: full carousel -->
      <div class="hidden lg:flex flex-col gap-3">
        <!-- Main image -->
        <div class="relative bg-[#111113] border border-[#1f1f22] rounded-xl overflow-hidden group cursor-pointer" data-open-lightbox data-index="0">
          <img
            src={images[0]}
            alt={`${t(lang, "carousel.screenshotAlt")} 1`}
            class="w-full aspect-[4/3] object-contain"
            loading="lazy"
          />
          <!-- Nav arrows (only when >1 image) -->
          {count > 1 && (
            <>
              <button
                class="carousel-prev absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/60 text-white/60 hover:text-white hover:bg-black/80 flex items-center justify-center transition-all duration-200 opacity-0 group-hover:opacity-100 z-10 cursor-pointer"
                type="button"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              </button>
              <button
                class="carousel-next absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-black/60 text-white/60 hover:text-white hover:bg-black/80 flex items-center justify-center transition-all duration-200 opacity-0 group-hover:opacity-100 z-10 cursor-pointer"
                type="button"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </button>
            </>
          )}
          <!-- Counter -->
          {count > 1 && (
            <span class="carousel-counter absolute top-3 right-3 text-[0.6875rem] text-white/70 font-mono bg-black/60 px-2 py-1 rounded-md pointer-events-none">
              1 / {count}
            </span>
          )}
        </div>

        <!-- Thumbnails strip -->
        {count > 1 && (
          <div class="flex gap-2 overflow-x-auto pb-1">
            {images.map((img, i) => (
              <button
                class="carousel-thumb flex-shrink-0 w-12 h-12 rounded-lg border-2 overflow-hidden bg-[#111113] transition-all duration-200 cursor-pointer hover:border-[#f97316]/50"
                data-index={i}
                data-lightbox-trigger={i}
                type="button"
              >
                <img
                  src={img}
                  alt={`${t(lang, "carousel.screenshotAlt")} ${i + 1}`}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Mobile: single thumbnail + counter badge -->
      <button
        class="lg:hidden relative w-full bg-[#111113] border border-[#1f1f22] rounded-xl overflow-hidden flex items-center justify-center cursor-pointer hover:border-[#2e2e33] transition-colors duration-200"
        data-mobile-lightbox
        type="button"
      >
        <img
          src={images[0]}
          alt={`${t(lang, "carousel.screenshotAlt")} 1`}
          class="w-full h-48 object-contain"
          loading="lazy"
        />
        {count > 1 && (
          <span class="absolute bottom-3 right-3 text-[0.6875rem] text-white/80 font-mono bg-black/70 px-2.5 py-1 rounded-full">
            +{count - 1} {t(lang, "carousel.photos")}
          </span>
        )}
      </button>
    </div>
  )
}
