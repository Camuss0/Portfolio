---
import type { Project } from "../../types/data";
import Tag from "../ui/Tag.astro";
import ProjectCarousel from "./ProjectCarousel.astro";
import { t, type Lang } from "../../i18n/ui";
import { getSkillIcon } from "../../utils/icons";
export interface Props {
  project: Project | undefined;
  lang: Lang;
}
const { project, lang } = Astro.props;
if (!project) return;
const hasScreenshots = project.screenshots.length > 0;
---

<article class="sm:flex sm:flex-col sm:flex-1 sm:min-h-0">
  <!-- Fixed header: name + close -->
  <div class="flex-shrink-0 bg-[#161618] z-10 px-5 sm:px-8 md:px-10 pt-4 sm:pt-5 md:pt-6 pb-3 border-b border-[#1f1f22]">
    <div class="flex items-center justify-between gap-4">
      <h3 class="text-[1.25rem] sm:text-[1.5rem] md:text-[1.75rem] font-bold text-[#f4f4f5] leading-[1.15] -tracking-[0.02em]">
        {project.name}
      </h3>
      <button
        class="modal-close-btn flex-shrink-0 text-[#7a7a85] hover:text-[#f4f4f5] transition-colors duration-200 text-xl leading-none bg-[#111113] border border-[#1f1f22] rounded-full w-9 h-9 flex items-center justify-center cursor-pointer"
        type="button"
        aria-label={t(lang, "aria.close")}
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Scrollable content -->
  <div class="sm:flex-1 sm:overflow-y-auto pt-4 sm:pt-5 md:pt-6">

  <!-- Type · badges (scrolls with content) -->
  <div class="px-5 sm:px-8 md:px-10 mb-5">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="text-[0.6875rem] text-[#f97316] font-mono tracking-wider">{project.type}</span>
      {(project.company || project.client) && (
        <>
          <span class="text-[0.625rem] text-[#3f3f46] select-none" aria-hidden="true">&middot;</span>
          <span class="inline-flex items-center gap-1.5 text-[0.6875rem] bg-[#f97316]/10 border border-[#f97316]/20 px-3 py-1.5 rounded-full">
            {project.company && <span class="text-[#a1a1aa] font-mono">{t(lang, "badge.developed_at", { company: project.company })}</span>}
            {project.company && project.client && <span class="text-[#f97316] text-[0.625rem]">&rarr;</span>}
            {project.client && (
              <>
                {project.client_logo && (
                  <img src={project.client_logo} alt={project.client ?? ""} class="w-4 h-4 rounded-full object-cover flex-shrink-0" />
                )}
                <span class="text-[#f4f4f5] font-medium">{project.client}</span>
              </>
            )}
          </span>
        </>
      )}
    </div>
  </div>

  <!-- Grid: content left + carousel right -->
  <div class="px-5 sm:px-8 md:px-10 pb-5 sm:pb-8 md:pb-10">
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-10">
    <!-- Left column: content -->
    <div class="min-w-0">
      {project.description && (
        <p class="text-[0.8125rem] sm:text-[0.875rem] text-[#a1a1aa] leading-[1.7] mb-8">
          {project.description}
        </p>
      )}

      {project.problem_solved && (
        <div class="mb-8 p-5 bg-[#111113] border border-[#1f1f22] rounded-xl">
          <h4 class="text-[0.6875rem] font-medium tracking-[0.08em] uppercase text-[#f97316] mb-2">
            {t(lang, "modal.problem")}
          </h4>
          <p class="text-[0.8125rem] text-[#a1a1aa] leading-[1.65]">
            {project.problem_solved}
          </p>
        </div>
      )}

      {project.key_features.length > 0 && (
        <div class="mb-8">
          <h4 class="text-[0.6875rem] font-medium tracking-[0.08em] uppercase text-[#71717a] mb-3">
            {t(lang, "modal.features")}
          </h4>
          <div class="flex flex-wrap gap-2">
            {project.key_features.map((f) => <Tag label={f} />)}
          </div>
        </div>
      )}

      {project.engineering_challenges.length > 0 && (
        <div class="mb-8">
          <h4 class="text-[0.6875rem] font-medium tracking-[0.08em] uppercase text-[#71717a] mb-2">
            {t(lang, "modal.challenges")}
          </h4>
          <ul class="space-y-2">
            {project.engineering_challenges.map((c) => (
              <li class="flex items-start gap-2 text-[0.8125rem] text-[#a1a1aa] leading-[1.6]">
                <span class="w-1 h-1 rounded-full bg-[#f97316]/50 mt-2 flex-shrink-0"></span>
                {c}
              </li>
            ))}
          </ul>
        </div>
      )}

      {project.tech_stack.length > 0 && (
        <div class="mb-8">
          <h4 class="text-[0.6875rem] font-medium tracking-[0.08em] uppercase text-[#71717a] mb-3">
            {t(lang, "modal.stack")}
          </h4>
          <div class="flex flex-wrap gap-2">
            {project.tech_stack.map((s) => <Tag label={s} mono={true} icon={getSkillIcon(s)} />)}
          </div>
        </div>
      )}

      {project.integrations.length > 0 && (
        <div class="mb-8">
          <h4 class="text-[0.6875rem] font-medium tracking-[0.08em] uppercase text-[#71717a] mb-3">
            {t(lang, "modal.integrations")}
          </h4>
          <div class="flex flex-wrap gap-2">
            {project.integrations.map((i) => <Tag label={i} mono={true} icon={getSkillIcon(i)} />)}
          </div>
        </div>
      )}
    </div>

    <!-- Right column: carousel -->
    <div class="min-w-0">
      {hasScreenshots && <ProjectCarousel projectId={project.id} screenshots={project.screenshots} lang={lang} />}
    </div>
  </div>
  </div>
  </div>
</article>
