---
export interface Props {
  projectId: string;
}
const { projectId } = Astro.props;
const images = ["01.webp", "02.webp", "03.webp", "04.webp", "05.webp"];
---

{
  images.length > 0 && (
    <div class="pt-4">
      <h4 class="text-[0.6875rem] font-medium tracking-[0.08em] uppercase text-[#71717a] mb-4">
        Screenshots
      </h4>
      <div class="grid grid-cols-1 gap-4">
        {images.map((img, i) => (
          <div class="relative bg-[#111113] border border-[#1f1f22] rounded-xl overflow-hidden group">
            <img
              src={`/images/projects/${projectId}/${img}`}
              alt={`Screenshot ${i + 1}`}
              class="w-full h-64 object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500"
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
            />
            <div class="hidden w-full h-64 items-center justify-center text-xs text-[#2e2e33] font-mono">
              {projectId}/{img}
            </div>
          </div>
        ))}
      </div>
    </div>
  )
}
