---
import { t, type Lang } from "../../i18n/ui";
export interface Props {
  projectId: string;
  screenshots: string[];
  lang: Lang;
}
const { projectId, screenshots, lang } = Astro.props;
---

{
  screenshots.length > 0 && (
    <div class="pt-4">
      <h4 class="text-[0.6875rem] font-medium tracking-[0.08em] uppercase text-[#71717a] mb-4">
        {t(lang, "gallery.screenshots")}
      </h4>

      {
        screenshots.length === 3 ? (
          <div class="flex flex-col sm:flex-row gap-4 items-start">
            <div class="flex-1 flex flex-col gap-4 w-full">
              <div class="bg-[#111113] border border-[#1f1f22] rounded-xl overflow-hidden">
                <img
                  src={`/images/projects/${projectId}/${screenshots[0]}`}
                  alt={`${t(lang, "gallery.screenshotAlt")} 1`}
                  class="w-full h-auto object-contain"
                  loading="lazy"
                />
              </div>
              <div class="bg-[#111113] border border-[#1f1f22] rounded-xl overflow-hidden">
                <img
                  src={`/images/projects/${projectId}/${screenshots[1]}`}
                  alt={`${t(lang, "gallery.screenshotAlt")} 2`}
                  class="w-full h-auto object-contain"
                  loading="lazy"
                />
              </div>
            </div>
            <div class="flex-shrink-0 w-full sm:w-[280px] bg-[#111113] border border-[#1f1f22] rounded-xl overflow-hidden">
              <img
                src={`/images/projects/${projectId}/${screenshots[2]}`}
                alt={`${t(lang, "gallery.screenshotAlt")} 3`}
                class="w-full h-auto object-contain"
                loading="lazy"
              />
            </div>
          </div>
        ) : (
          <div class="space-y-4">
            {screenshots.map((img, i) => (
              <div class="bg-[#111113] border border-[#1f1f22] rounded-xl overflow-hidden">
                <img
                  src={`/images/projects/${projectId}/${img}`}
                  alt={`${t(lang, "gallery.screenshotAlt")} ${i + 1}`}
                  class="w-full h-auto object-contain"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        )
      }
    </div>
  )
}
