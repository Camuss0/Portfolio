---
export interface Props {
  currentProjectId: string | null;
  onClose?: string;
}
const { currentProjectId } = Astro.props;
---

{
  currentProjectId && (
    <div
      id="modal-overlay"
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/90"
      data-close-modal=""
    >
      <div
        id="modal-content"
        class="bg-[#161618] border border-[#1f1f22] rounded-2xl max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto relative"
      >
        <button
          id="modal-close"
          class="absolute top-4 right-4 text-[#7a7a85] hover:text-[#f4f4f5] transition-colors duration-200 text-xl leading-none bg-[#111113] border border-[#1f1f22] rounded-full w-10 h-10 flex items-center justify-center cursor-pointer z-20"
          data-close-modal=""
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <div class="p-8 md:p-10">
          <slot />
        </div>
      </div>
    </div>
  )
}
