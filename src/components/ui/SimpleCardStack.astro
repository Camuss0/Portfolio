---
export interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div id="card-stack" class="relative w-full aspect-square {className}">
  <div class="card absolute inset-0 rounded-[32px] bg-cover bg-center cursor-grab select-none touch-none border border-[#1f1f22]" style="background-image:url('/images/personal/pro.png')">
    <span class="absolute top-3 right-3 flex items-center justify-center w-[26px] h-[26px] rounded-lg bg-[#0a0a0b]/60 backdrop-blur-sm pointer-events-none">
      <svg class="w-3.5 h-4 text-[#71717a]/60" viewBox="0 0 8 12" fill="currentColor"><circle cx="2" cy="1.5" r="0.9"/><circle cx="6" cy="1.5" r="0.9"/><circle cx="2" cy="6" r="0.9"/><circle cx="6" cy="6" r="0.9"/><circle cx="2" cy="10.5" r="0.9"/><circle cx="6" cy="10.5" r="0.9"/></svg>
    </span>
  </div>
  <div class="card absolute inset-0 rounded-[32px] bg-cover bg-center cursor-grab select-none touch-none border border-[#1f1f22]" style="background-image:url('/images/personal/diploma.png')"></div>
  <div class="card absolute inset-0 rounded-[32px] bg-cover bg-center cursor-grab select-none touch-none border border-[#1f1f22]" style="background-image:url('/images/personal/pic.jpg')"></div>
</div>

<script is:inline>
  (function() {
    var CFG = {
      depthX: 37,
      depthY: 31,
      scaleStep: 0.06,
      rotationStep: 6,
      autoplay: 3800,
      dragDistance: 80,
      dragElastic: 0.55,
      dragScale: 1.03,
      animationDuration: 1600
    };

    var cards = Array.from(document.querySelectorAll('#card-stack .card'));
    var stack = document.getElementById('card-stack');
    if (!stack || cards.length < 2) return;

    var autoplayTimer = null;
    var isDragging = false;
    var activeCard = null;

    function layout() {
      if (isDragging) return;
      for (var i = 0; i < cards.length; i++) {
        cards[i].style.transition = 'transform ' + CFG.animationDuration + 'ms cubic-bezier(.22,1,.36,1)';
        cards[i].style.transform = 'translate3d(' + (i * CFG.depthX) + 'px,' + (i * CFG.depthY) + 'px,0) scale(' + (1 - i * CFG.scaleStep) + ') rotate(' + (i * CFG.rotationStep) + 'deg)';
        cards[i].style.zIndex = 100 - i;
      }
    }

    function applyNext() {
      // Rotate array: first becomes last
      var first = cards.shift();
      cards.push(first);
      // Apply new z-index and transforms without DOM manipulation
      for (var i = 0; i < cards.length; i++) {
        cards[i].style.transition = 'transform ' + CFG.animationDuration + 'ms cubic-bezier(.22,1,.36,1)';
        cards[i].style.transform = 'translate3d(' + (i * CFG.depthX) + 'px,' + (i * CFG.depthY) + 'px,0) scale(' + (1 - i * CFG.scaleStep) + ') rotate(' + (i * CFG.rotationStep) + 'deg)';
        cards[i].style.zIndex = 100 - i;
      }
    }

    function rotate() {
      if (isDragging) return;
      applyNext();
    }

    function startAutoplay() {
      clearInterval(autoplayTimer);
      autoplayTimer = setInterval(rotate, CFG.autoplay);
    }

    cards.forEach(function(card) {
      var startX = 0, startY = 0, currentX = 0, currentY = 0;

      card.addEventListener('pointerdown', function(e) {
        if (activeCard) return;
        if (card !== cards[0]) return;
        isDragging = true;
        activeCard = card;
        clearInterval(autoplayTimer);

        startX = e.clientX;
        startY = e.clientY;
        card.style.transition = 'none';

        function move(ev) {
          var dx = ev.clientX - startX;
          var dy = ev.clientY - startY;
          var damping = 1 / (1 + CFG.dragElastic * 2.5);
          currentX = dx * damping;
          currentY = dy * damping;
          card.style.transform = 'translate3d(' + currentX + 'px,' + currentY + 'px,0) scale(' + CFG.dragScale + ') rotate(' + (currentX * 0.04) + 'deg)';
        }

        function up() {
          window.removeEventListener('pointermove', move);
          window.removeEventListener('pointerup', up);

          var exceeded = Math.abs(currentX) > CFG.dragDistance || Math.abs(currentY) > CFG.dragDistance;

          card.style.transition = 'transform ' + CFG.animationDuration + 'ms cubic-bezier(.22,1,.36,1)';

          if (exceeded) {
            requestAnimationFrame(function() {
              var first = cards.shift();
              cards.push(first);
              isDragging = false;
              activeCard = null;
              layout();
              startAutoplay();
            });
          } else {
            isDragging = false;
            activeCard = null;
            layout();
            startAutoplay();
          }
        }

        window.addEventListener('pointermove', move);
        window.addEventListener('pointerup', up);
      });
    });

    layout();
    startAutoplay();
  })();
</script>
