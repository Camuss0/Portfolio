---
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#0a0a0b]/80 backdrop-blur-md border-b border-[#1f1f22]/40">
  <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="#" class="text-[#f4f4f5] font-bold text-lg tracking-tight no-underline font-feature-ss relative group">
      <span class="relative z-10">Camuss0</span>
      <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#fbbf24] transition-all duration-300 group-hover:w-full"></span>
    </a>

    <!-- Center Navigation -->
    <div class="hidden md:flex items-center gap-1 bg-[#111113]/80 border border-[#1f1f22]/60 rounded-full px-2 py-1">
      <a href="#projects" class="nav-link text-[0.8125rem] text-[#71717a] hover:text-[#f4f4f5] px-4 py-1.5 rounded-full transition-all duration-200 no-underline font-medium">
        Projects
      </a>
      <a href="#skills" class="nav-link text-[0.8125rem] text-[#71717a] hover:text-[#f4f4f5] px-4 py-1.5 rounded-full transition-all duration-200 no-underline font-medium">
        Skills
      </a>
      <a href="#experience" class="nav-link text-[0.8125rem] text-[#71717a] hover:text-[#f4f4f5] px-4 py-1.5 rounded-full transition-all duration-200 no-underline font-medium">
        Experience
      </a>
    </div>

    <!-- Language Selector -->
    <div class="flex items-center gap-2">
      <button class="language-btn text-[0.75rem] text-[#52525b] hover:text-[#f4f4f5] transition-colors duration-200 font-medium" data-lang="en">
        EN
      </button>
      <span class="text-[#2e2e33] text-[0.75rem]">/</span>
      <button class="language-btn text-[0.75rem] text-[#52525b] hover:text-[#f4f4f5] transition-colors duration-200 font-medium" data-lang="es">
        ES
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-link.active {
    color: #f4f4f5;
    background: rgba(255, 255, 255, 0.05);
  }
</style>
