---
import type { Personal } from "../../types/data";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { t, type Lang } from "../../i18n/ui";
import "../../styles/global.css";
export interface Props {
  title?: string;
  description?: string;
  personal: Personal;
  lang: Lang;
}
const { title: rawTitle, description: rawDescription, personal, lang } = Astro.props;
const title = rawTitle ?? t(lang, "layout.title");
const description = rawDescription ?? t(lang, "layout.description");
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://camuss0.dev/" />
    <link rel="icon" type="image/png" href="/logoTransparente.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://camuss0.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://camuss0.dev/images/personal/pic.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="es" href="https://camuss0.dev/" />
    <link rel="alternate" hreflang="en" href="https://camuss0.dev/" />
    <link rel="alternate" hreflang="x-default" href="https://camuss0.dev/" />

    <!-- Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Valentin Camusso",
        "url": "https://camuss0.dev/",
        "jobTitle": "Full Stack Developer",
        "description": {description},
        "sameAs": [
          "https://github.com/Camuss0",
          "https://linkedin.com/in/camuss0"
        ],
        "knowsAbout": ["Web Development", "Mobile Apps", "Backend Systems", "AI", "API Integration", "GPS Tracking"]
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-[#0a0a0b] text-[#f4f4f5]">
    <Header lang={lang} />
    <main class="flex-1 relative">
      <slot />
    </main>
    <Footer personal={personal} />
  </body>
</html>
