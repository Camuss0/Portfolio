---
import type { Personal } from "../../types/data";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { t, type Lang } from "../../i18n/ui";
import "../../styles/global.css";
export interface Props {
  title?: string;
  description?: string;
  personal: Personal;
  lang: Lang;
}
const { title: rawTitle, description: rawDescription, personal, lang } = Astro.props;
const title = rawTitle ?? t(lang, "layout.title");
const description = rawDescription ?? t(lang, "layout.description");
const jobTitle = lang === "es" ? "Desarrollador Full Stack" : "Full Stack Developer";
const schemaDescription = lang === "es"
  ? "Desarrollador Full Stack. Construyo aplicaciones web, móviles, sistemas backend y soluciones con IA."
  : "Full Stack Developer. Building web apps, mobile apps, backend systems and AI solutions.";
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://www.camuss0.dev/" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" href="/logoTransparente.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://www.camuss0.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://www.camuss0.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="es" href="https://www.camuss0.dev/" />
    <link rel="alternate" hreflang="en" href="https://www.camuss0.dev/" />
    <link rel="alternate" hreflang="x-default" href="https://www.camuss0.dev/" />

    <!-- Schema -->
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Valentin Camusso",
  "url": "https://www.camuss0.dev/",
  "jobTitle": "{jobTitle}",
  "description": "{schemaDescription}",
  "sameAs": [
    "https://github.com/Camuss0",
    "https://linkedin.com/in/camuss0"
  ],
  "knowsAbout": ["Web Development", "Mobile Apps", "Backend Systems", "AI", "API Integration", "GPS Tracking"]
}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-[#0a0a0b] text-[#f4f4f5]">
    <Header lang={lang} />
    <main class="flex-1 relative">
      <slot />
    </main>
    <Footer personal={personal} />
    <button id="back-to-top" class="fixed bottom-6 right-6 z-40 w-10 h-10 rounded-full bg-[#111113] border border-[#1f1f22] text-[#a1a1aa] hover:text-[#f4f4f5] hover:border-[#2e2e33] flex items-center justify-center cursor-pointer transition-all duration-300 ease-out" style="opacity:0;transform:translateY(12px);pointer-events:none" aria-label={t(lang, "aria.backToTop")} data-aria-label-es={t("es", "aria.backToTop")} data-aria-label-en={t("en", "aria.backToTop")}>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M18 15l-6-6-6 6" />
      </svg>
    </button>
    <script is:inline>
      (function() {
        var btn = document.getElementById("back-to-top");
        if (!btn) return;
        btn.addEventListener("click", function() {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
        function toggle() {
          var y = window.scrollY || document.documentElement.scrollTop;
          if (y > 300) {
            btn.style.opacity = "1";
            btn.style.transform = "translateY(0)";
            btn.style.pointerEvents = "auto";
          } else {
            btn.style.opacity = "0";
            btn.style.transform = "translateY(12px)";
            btn.style.pointerEvents = "none";
          }
        }
        window.addEventListener("scroll", toggle, { passive: true });
        toggle();
      })();
    </script>
  </body>
</html>
