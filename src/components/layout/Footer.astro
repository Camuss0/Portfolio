---
import type { Personal } from "../../types/data";
import { t } from "../../i18n/ui";
export interface Props {
  personal: Personal;
}
const { personal } = Astro.props;
---

<footer class="border-t border-[#1f1f22]/40 mt-0 py-12 sm:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-[#f4f4f5] font-bold text-sm">Camuss0</span>
        <span class="text-[#2e2e33]">&middot;</span>
        <span class="text-[0.75rem] sm:text-[0.8125rem] text-[#7a7a85]">{personal.location}</span>
      </div>
      <span class="text-[0.75rem] text-[#7a7a85]">
        <span class="lang-text-es">{t("es", "footer.built")}</span>
        <span class="lang-text-en" style="display: none;">{t("en", "footer.built")}</span>
      </span>
      </div>
  </div>
</footer>
