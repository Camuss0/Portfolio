---
import type { Personal } from "../../types/data";
import { t, type Lang } from "../../i18n/ui";
export interface Props {
  personal: Personal;
  lang: Lang;
}
const { personal, lang } = Astro.props;
---

<footer class="border-t border-[#1f1f22]/40 mt-0">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-[#f4f4f5] font-bold text-sm">Camuss0</span>
        <span class="text-[#2e2e33]">&middot;</span>
        <span class="text-[0.75rem] sm:text-[0.8125rem] text-[#7a7a85]">{personal.location}</span>
      </div>
      <div class="flex items-center gap-6">
        <span class="text-[0.75rem] text-[#7a7a85]">&copy; {new Date().getFullYear()}</span>
      </div>
    </div>
  </div>
</footer>
