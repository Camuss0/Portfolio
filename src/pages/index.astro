---
import fs from "node:fs";
import Layout from "../components/layout/Layout.astro";
import Hero from "../components/home/Hero.astro";
import ProjectsSection from "../components/home/ProjectsSection.astro";
import StudiesExperienceSection from "../components/home/StudiesExperienceSection.astro";
import SkillsSection from "../components/home/SkillsSection.astro";
import ContactSection from "../components/home/ContactSection.astro";
import ProjectModal from "../components/projects/ProjectModal.astro";
import type { PortfolioData } from "../types/data";
import { translations } from "../i18n/ui";

const rawEs = fs.readFileSync("./data/data_es.json", "utf-8");
const rawEn = fs.readFileSync("./data/data_en.json", "utf-8");
const dataEs: PortfolioData = JSON.parse(rawEs);
const dataEn: PortfolioData = JSON.parse(rawEn);
---

<Layout lang="es" personal={dataEs.personal}>
  <!-- Hero (single instance, contains both language texts internally) -->
  <Hero personalEs={dataEs.personal} personalEn={dataEn.personal} lang="es" />

  <div id="lang-es" class="lang-content">
    <ProjectsSection projects={dataEs.projects} lang="es" />
    <StudiesExperienceSection studies={dataEs.studies} certifications={dataEs.certifications} experience={dataEs.experience} lang="es" />
    <SkillsSection skills={dataEs.skills} lang="es" />
  </div>
  <div id="lang-en" class="lang-content" style="display: none;">
    <ProjectsSection projects={dataEn.projects} lang="en" />
    <StudiesExperienceSection studies={dataEn.studies} certifications={dataEn.certifications} experience={dataEn.experience} lang="en" />
    <SkillsSection skills={dataEn.skills} lang="en" />
  </div>

  <ContactSection personal={dataEs.personal} />

  <!-- Modal -->
  <div
    id="modal-overlay"
    class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center bg-black/90"
  >
    <div
      id="modal-container"
      class="modal-panel bg-[#161618] border border-[#1f1f22] rounded-2xl max-w-7xl w-full mx-2 sm:mx-4 max-h-[85vh] sm:max-h-[90vh] overflow-y-auto relative"
    >
      <button
        id="modal-close-btn"
        class="fixed top-2 right-2 sm:top-4 sm:right-4 text-[#7a7a85] hover:text-[#f4f4f5] transition-colors duration-200 text-xl leading-none bg-[#111113] border border-[#1f1f22] rounded-full w-10 h-10 flex items-center justify-center cursor-pointer z-20"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <div class="p-5 sm:p-8 md:p-10" id="modal-body">
        <div id="modal-lang-es">
          {dataEs.projects.map((p) => (
            <div id={`project-content-${p.id}`} class="hidden">
              <ProjectModal project={p} lang="es" />
            </div>
          ))}
        </div>
        <div id="modal-lang-en" style="display: none;">
          {dataEn.projects.map((p) => (
            <div id={`project-content-${p.id}`} class="hidden">
              <ProjectModal project={p} lang="en" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div
    id="lightbox-overlay"
    class="lightbox-backdrop fixed inset-0 z-[60] flex items-center justify-center bg-black/95"
  >
    <button
      id="lightbox-close"
      class="fixed top-2 right-2 sm:top-4 sm:right-4 text-[#7a7a85] hover:text-[#f4f4f5] transition-colors duration-200 text-xl leading-none bg-[#111113] border border-[#1f1f22] rounded-full w-10 h-10 flex items-center justify-center cursor-pointer z-20"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <button
      id="lightbox-prev"
      class="fixed left-2 sm:left-4 top-1/2 -translate-y-1/2 text-white/50 hover:text-white bg-black/60 hover:bg-black/80 rounded-full w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center transition-all duration-200 cursor-pointer z-10"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button
      id="lightbox-next"
      class="fixed right-2 sm:right-4 top-1/2 -translate-y-1/2 text-white/50 hover:text-white bg-black/60 hover:bg-black/80 rounded-full w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center transition-all duration-200 cursor-pointer z-10"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
    </button>
    <div id="lightbox-counter" class="fixed bottom-4 sm:bottom-6 left-1/2 -translate-x-1/2 text-[0.75rem] text-white/60 font-mono z-10"></div>
    <img id="lightbox-img" src="" alt="" class="max-w-[90vw] max-h-[85vh] object-contain rounded-lg transition-opacity duration-300 z-10" />
  </div>

  <script is:inline>
    window.setLanguage = function(lang) {
      localStorage.setItem("lang", lang);

      var isEn = lang === "en";

      document.getElementById("lang-es").style.display = isEn ? "none" : "block";
      document.getElementById("lang-en").style.display = isEn ? "block" : "none";
      document.getElementById("hero-text-es").style.display = isEn ? "none" : "block";
      document.getElementById("hero-text-en").style.display = isEn ? "block" : "none";

      var modalEs = document.getElementById("modal-lang-es");
      var modalEn = document.getElementById("modal-lang-en");
      if (modalEs) modalEs.style.display = isEn ? "none" : "block";
      if (modalEn) modalEn.style.display = isEn ? "block" : "none";

      document.querySelectorAll(".lang-text-es").forEach(function(el) {
        el.style.display = isEn ? "none" : "";
      });
      document.querySelectorAll(".lang-text-en").forEach(function(el) {
        el.style.display = isEn ? "" : "none";
      });

      document.querySelectorAll(".language-btn").forEach(function(btn) {
        var active = btn.getAttribute("data-lang") === lang;
        btn.classList.toggle("lang-active", active);
        var indicator = btn.querySelector(".lang-indicator");
        if (indicator) indicator.style.opacity = active ? "1" : "0";
      });



      if (typeof window.updateContactPlaceholders === "function") {
        window.updateContactPlaceholders();
      }
    }

    window.setLanguage(localStorage.getItem("lang") || "es");
  </script>

  <script is:inline>
    function showModal(id) {
      var overlay = document.getElementById("modal-overlay");
      var container = document.getElementById("modal-container");
      var modalBody = document.getElementById("modal-body");
      var contents = modalBody.querySelectorAll("div[id^='project-content-']");
      for (var i = 0; i < contents.length; i++) {
        var el = contents[i];
        if (el.id === "project-content-" + id) {
          el.classList.remove("hidden");

        } else {
          el.classList.add("hidden");
        }
      }
      overlay.classList.add("active");
      container.classList.add("active");
      document.body.style.overflow = "hidden";
      currentId = id;
    }

    function closeModal() {
      var overlay = document.getElementById("modal-overlay");
      var container = document.getElementById("modal-container");
      overlay.classList.remove("active");
      container.classList.remove("active");
      document.body.style.overflow = "";
      currentId = null;
    }

    var currentId = null;

    // ===== Carousel =====
    document.addEventListener("click", function(e) {
      var prevBtn = e.target.closest(".carousel-prev");
      var nextBtn = e.target.closest(".carousel-next");
      var thumb = e.target.closest(".carousel-thumb");

      if (prevBtn || nextBtn) {
        e.preventDefault();
        var carousel = (prevBtn || nextBtn).closest(".project-carousel");
        if (!carousel) return;
        var images = JSON.parse(carousel.getAttribute("data-images"));
        var mainImg = carousel.querySelector("img:first-of-type");
        var counterEl = carousel.querySelector(".carousel-counter");
        var currentIdx = parseInt(carousel.getAttribute("data-current") || "0");
        var newIdx = prevBtn ? currentIdx - 1 : currentIdx + 1;
        if (newIdx < 0) newIdx = images.length - 1;
        if (newIdx >= images.length) newIdx = 0;
        carousel.setAttribute("data-current", newIdx);
        mainImg.src = images[newIdx];
        mainImg.alt = mainImg.alt.replace(/\d+/, String(newIdx + 1));
        if (counterEl) counterEl.textContent = (newIdx + 1) + " / " + images.length;
        // Update active thumbnail
        carousel.querySelectorAll(".carousel-thumb").forEach(function(t, i) {
          t.style.borderColor = i === newIdx ? "#f97316" : "";
          t.style.opacity = i === newIdx ? "1" : "0.5";
        });
        // Update lightbox trigger index
        var lightboxTrigger = carousel.querySelector("[data-open-lightbox]");
        if (lightboxTrigger) lightboxTrigger.setAttribute("data-index", newIdx);
      }

      if (thumb) {
        var carousel = thumb.closest(".project-carousel");
        if (!carousel) return;
        var images = JSON.parse(carousel.getAttribute("data-images"));
        var index = parseInt(thumb.getAttribute("data-index"));
        var mainImg = carousel.querySelector("img:first-of-type");
        var counterEl = carousel.querySelector(".carousel-counter");
        carousel.setAttribute("data-current", index);
        mainImg.src = images[index];
        mainImg.alt = mainImg.alt.replace(/\d+/, String(index + 1));
        if (counterEl) counterEl.textContent = (index + 1) + " / " + images.length;
        carousel.querySelectorAll(".carousel-thumb").forEach(function(t, i) {
          t.style.borderColor = i === index ? "#f97316" : "";
          t.style.opacity = i === index ? "1" : "0.5";
        });
        var lightboxTrigger = carousel.querySelector("[data-open-lightbox]");
        if (lightboxTrigger) lightboxTrigger.setAttribute("data-index", index);
      }
    });

    // Initialize carousel thumbnails active state
    document.querySelectorAll(".project-carousel").forEach(function(carousel) {
      var thumbs = carousel.querySelectorAll(".carousel-thumb");
      if (thumbs.length > 0) {
        thumbs[0].style.borderColor = "#f97316";
        for (var i = 1; i < thumbs.length; i++) thumbs[i].style.opacity = "0.5";
      }
    });

    // ===== Lightbox =====
    var lbImages = [];
    var lbIndex = 0;

    function showLightbox(images, index) {
      lbImages = images;
      lbIndex = index;
      updateLightboxImage();
      var overlay = document.getElementById("lightbox-overlay");
      overlay.classList.add("active");
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      var overlay = document.getElementById("lightbox-overlay");
      overlay.classList.remove("active");
      document.body.style.overflow = "";
    }

    function updateLightboxImage() {
      var img = document.getElementById("lightbox-img");
      var counter = document.getElementById("lightbox-counter");
      var prev = document.getElementById("lightbox-prev");
      var next = document.getElementById("lightbox-next");

      img.style.opacity = "0";
      setTimeout(function() {
        img.src = lbImages[lbIndex];
        img.style.opacity = "1";
      }, 150);

      counter.textContent = (lbIndex + 1) + " / " + lbImages.length;

      if (lbImages.length <= 1) {
        prev.style.display = "none";
        next.style.display = "none";
        counter.style.display = "none";
      } else {
        prev.style.display = "";
        next.style.display = "";
        counter.style.display = "";
      }
    }

    document.addEventListener("click", function(e) {
      // Open lightbox from carousel main image
      var trigger = e.target.closest("[data-open-lightbox]");
      if (trigger) {
        e.preventDefault();
        var carousel = trigger.closest(".project-carousel");
        if (!carousel) return;
        var images = JSON.parse(carousel.getAttribute("data-images"));
        var index = parseInt(trigger.getAttribute("data-index") || carousel.getAttribute("data-current") || "0");
        showLightbox(images, index);
        return;
      }

      // Open lightbox from mobile thumbnail
      var mobileBtn = e.target.closest("[data-mobile-lightbox]");
      if (mobileBtn) {
        e.preventDefault();
        var carousel = mobileBtn.closest(".project-carousel");
        if (!carousel) return;
        var images = JSON.parse(carousel.getAttribute("data-images"));
        showLightbox(images, 0);
        return;
      }

      // Lightbox prev/next
      if (e.target.closest("#lightbox-prev")) {
        lbIndex = lbIndex <= 0 ? lbImages.length - 1 : lbIndex - 1;
        updateLightboxImage();
      }
      if (e.target.closest("#lightbox-next")) {
        lbIndex = lbIndex >= lbImages.length - 1 ? 0 : lbIndex + 1;
        updateLightboxImage();
      }

      // Close lightbox
      if (e.target.closest("#lightbox-close") || e.target === document.getElementById("lightbox-overlay")) {
        closeLightbox();
      }
    });

    document.addEventListener("keydown", function(e) {
      var lb = document.getElementById("lightbox-overlay");
      var lbOpen = lb && lb.classList.contains("active");

      if (lbOpen) {
        if (e.key === "Escape") closeLightbox();
        if (e.key === "ArrowLeft") { lbIndex = lbIndex <= 0 ? lbImages.length - 1 : lbIndex - 1; updateLightboxImage(); }
        if (e.key === "ArrowRight") { lbIndex = lbIndex >= lbImages.length - 1 ? 0 : lbIndex + 1; updateLightboxImage(); }
        return;
      }

      if (e.key === "Escape" && currentId) closeModal();
    });

    document.addEventListener("click", function (e) {
      var card = e.target.closest("[data-open-modal]");
      if (card) {
        var id = card.getAttribute("data-project-id");
        if (id) showModal(id);
      }
      if (
        e.target.closest("#modal-close-btn") ||
        e.target === document.getElementById("modal-overlay")
      ) {
        closeModal();
      }
    });

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -200px 0px" }
    );

    document.querySelectorAll(".reveal, .reveal-left, .reveal-right, .reveal-scale").forEach(function (el) {
      observer.observe(el);
    });

    var sections = ["projects", "studies", "skills", "contact"];
    var navLinks = document.querySelectorAll(".nav-link");

    document.addEventListener("click", function(e) {
      var link = e.target.closest(".nav-link");
      if (link) {
        var href = link.getAttribute("href");
        if (href && href[0] === "#") {
          e.preventDefault();
          var esSec = document.getElementById(href.slice(1));
          if (!esSec) return;
          var esParent = document.getElementById("lang-es");
          var enParent = document.getElementById("lang-en");
          var idx = 0; while (idx < esParent.children.length && esParent.children[idx] !== esSec) idx++;
          var visible = enParent.style.display !== "none" ? enParent : esParent;
          var target = visible.children[idx] || esSec;
          target.scrollIntoView({ behavior: "smooth" });
          history.replaceState(null, "", href);
        }
      }
    });
    
    window.addEventListener("scroll", function() {
      var current = "";
      sections.forEach(function(section) {
        var esSec = document.getElementById(section);
        if (!esSec) return;
        var esParent = document.getElementById("lang-es");
        var enParent = document.getElementById("lang-en");
        var idx = 0; while (idx < esParent.children.length && esParent.children[idx] !== esSec) idx++;
        var visible = enParent.style.display !== "none" ? enParent : esParent;
        var element = visible.children[idx] || esSec;
        if (element) {
          var rect = element.getBoundingClientRect();
          if (rect.top <= 200) {
            current = section;
          }
        }
      });
      
      navLinks.forEach(function(link) {
        link.classList.remove("active");
        if (link.getAttribute("href") === "#" + current) {
          link.classList.add("active");
        }
      });
    });
  </script>
</Layout>
