---
import fs from "node:fs";
import Layout from "../components/layout/Layout.astro";
import Hero from "../components/home/Hero.astro";
import ProjectsSection from "../components/home/ProjectsSection.astro";
import StudiesExperienceSection from "../components/home/StudiesExperienceSection.astro";
import SkillsSection from "../components/home/SkillsSection.astro";
import ContactSection from "../components/home/ContactSection.astro";
import ProjectModal from "../components/projects/ProjectModal.astro";
import type { PortfolioData } from "../types/data";
import { translations } from "../i18n/ui";

const rawEs = fs.readFileSync("./data/data_es.json", "utf-8");
const rawEn = fs.readFileSync("./data/data_en.json", "utf-8");
const dataEs: PortfolioData = JSON.parse(rawEs);
const dataEn: PortfolioData = JSON.parse(rawEn);
---

<Layout lang="es" personal={dataEs.personal}>
  <!-- Hero (single instance, contains both language texts internally) -->
  <Hero personalEs={dataEs.personal} personalEn={dataEn.personal} lang="es" />

  <div id="lang-es" class="lang-content">
    <ProjectsSection projects={dataEs.projects} lang="es" />
    <StudiesExperienceSection studies={dataEs.studies} certifications={dataEs.certifications} experience={dataEs.experience} lang="es" />
    <SkillsSection skills={dataEs.skills} lang="es" />
  </div>
  <div id="lang-en" class="lang-content" style="display: none;">
    <ProjectsSection projects={dataEn.projects} lang="en" />
    <StudiesExperienceSection studies={dataEn.studies} certifications={dataEn.certifications} experience={dataEn.experience} lang="en" />
    <SkillsSection skills={dataEn.skills} lang="en" />
  </div>

  <ContactSection personal={dataEs.personal} />

  <!-- Modal -->
  <div
    id="modal-overlay"
    class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center bg-black/90 overscroll-contain"
  >
    <div
      id="modal-container"
      class="modal-panel bg-[#161618] border border-[#1f1f22] rounded-2xl max-w-7xl w-full mx-2 sm:mx-4 max-h-[85vh] sm:max-h-[90vh] flex flex-col min-h-0 relative"
    >
      <div class="flex flex-col flex-1 min-h-0" id="modal-body">
        <div id="modal-lang-es" class="flex flex-col flex-1 min-h-0">
          {dataEs.projects.map((p) => (
            <div id={`project-content-${p.id}`} class="hidden flex flex-col flex-1 min-h-0">
              <ProjectModal project={p} lang="es" />
            </div>
          ))}
        </div>
        <div id="modal-lang-en" style="display: none;" class="flex flex-col flex-1 min-h-0">
          {dataEn.projects.map((p) => (
            <div id={`project-content-${p.id}`} class="hidden flex flex-col flex-1 min-h-0">
              <ProjectModal project={p} lang="en" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Slide-in -->
  <div id="mobile-slide"
    class="fixed inset-0 z-50 bg-[#0a0a0b] flex flex-col min-h-0 overscroll-contain transition-transform duration-300 ease-out translate-x-full"
  >
    <div class="flex-shrink-0 z-10 flex items-center justify-between bg-[#0a0a0b]/95 border-b border-[#1f1f22] px-4 py-3">
      <span id="mobile-slide-title" class="text-[0.9375rem] font-semibold text-[#f4f4f5] truncate pr-2"></span>
      <button id="mobile-slide-close"
        class="text-[#7a7a85] hover:text-[#f4f4f5] bg-[#111113] border border-[#1f1f22] rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div id="mobile-slide-body" class="flex-1 overflow-y-auto overscroll-contain p-4">
      <div id="mobile-slide-es">
        {dataEs.projects.map((p) => (
          <div id={`mobile-project-content-${p.id}`} class="hidden">
            <ProjectModal project={p} lang="es" />
          </div>
        ))}
      </div>
      <div id="mobile-slide-en" style="display: none;">
        {dataEn.projects.map((p) => (
          <div id={`mobile-project-content-${p.id}`} class="hidden">
            <ProjectModal project={p} lang="en" />
          </div>
        ))}
      </div>
    </div>
  </div>

  <style is:global>
    #mobile-slide-body article > div:first-child {
      display: none;
    }
    #mobile-slide-body span {
      font-size: 0.6875rem !important;
    }
    #mobile-slide-body h3 {
      display: none;
    }
  </style>

  <!-- Lightbox -->
  <div
    id="lightbox-overlay"
    class="lightbox-backdrop fixed inset-0 z-[60] flex items-center bg-black/95 overflow-hidden"
  >
    <button
      id="lightbox-close"
      class="fixed top-3 right-3 sm:top-4 sm:right-4 text-white hover:text-white bg-black/40 hover:bg-black/60 rounded-full w-11 h-11 sm:w-10 sm:h-10 flex items-center justify-center cursor-pointer z-20 transition-all duration-200"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <button
      id="lightbox-prev"
      class="fixed left-2 sm:left-4 top-1/2 -translate-y-1/2 text-white hover:text-white bg-black/40 hover:bg-black/60 rounded-full w-12 h-12 sm:w-12 sm:h-12 flex items-center justify-center transition-all duration-200 cursor-pointer z-20"
      aria-label=""
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button
      id="lightbox-next"
      class="fixed right-2 sm:right-4 top-1/2 -translate-y-1/2 text-white hover:text-white bg-black/40 hover:bg-black/60 rounded-full w-12 h-12 sm:w-12 sm:h-12 flex items-center justify-center transition-all duration-200 cursor-pointer z-20"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
    </button>
    <div id="lightbox-counter" class="fixed bottom-4 sm:bottom-6 left-1/2 -translate-x-1/2 text-[0.75rem] text-white/60 font-mono z-20"></div>
    <div id="lightbox-track" class="flex"></div>
  </div>

  <script is:inline>
    window.setLanguage = function(lang) {
      localStorage.setItem("lang", lang);

      var isEn = lang === "en";

      document.getElementById("lang-es").style.display = isEn ? "none" : "block";
      document.getElementById("lang-en").style.display = isEn ? "block" : "none";
      document.getElementById("hero-text-es").style.display = isEn ? "none" : "block";
      document.getElementById("hero-text-en").style.display = isEn ? "block" : "none";

      var modalEs = document.getElementById("modal-lang-es");
      var modalEn = document.getElementById("modal-lang-en");
      if (modalEs) modalEs.style.display = isEn ? "none" : "flex";
      if (modalEn) modalEn.style.display = isEn ? "flex" : "none";

      document.querySelectorAll(".lang-text-es").forEach(function(el) {
        el.style.display = isEn ? "none" : "";
      });
      document.querySelectorAll(".lang-text-en").forEach(function(el) {
        el.style.display = isEn ? "" : "none";
      });

      document.querySelectorAll("[data-aria-label-es]").forEach(function(el) {
        el.setAttribute("aria-label", el.getAttribute(isEn ? "data-aria-label-en" : "data-aria-label-es") || el.getAttribute("aria-label"));
      });

      document.querySelectorAll(".language-btn").forEach(function(btn) {
        btn.classList.toggle("lang-active", btn.getAttribute("data-lang") === lang);
      });

      var cvLink = document.querySelector("[data-href-es]");
      if (cvLink) cvLink.href = cvLink.getAttribute("data-href-" + lang);



      if (typeof window.updateContactPlaceholders === "function") {
        window.updateContactPlaceholders();
      }
    }

    window.setLanguage(localStorage.getItem("lang") || "es");
  </script>

  <script is:inline>
    var bodyLockCount = 0;
    function lockBody() {
      if (bodyLockCount === 0) {
        document.documentElement.style.overflow = "hidden";
        document.body.style.overflow = "hidden";
        document.body.style.touchAction = "none";
      }
      bodyLockCount++;
    }
    function unlockBody() {
      bodyLockCount--;
      if (bodyLockCount > 0) return;
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";
      document.body.style.touchAction = "";
    }

    function showModal(id) {
      var overlay = document.getElementById("modal-overlay");
      var container = document.getElementById("modal-container");
      var modalBody = document.getElementById("modal-body");
      var contents = modalBody.querySelectorAll("div[id^='project-content-']");
      for (var i = 0; i < contents.length; i++) {
        var el = contents[i];
        if (el.id === "project-content-" + id) {
          el.classList.remove("hidden");

        } else {
          el.classList.add("hidden");
        }
      }
      overlay.classList.add("active");
      container.classList.add("active");
      lockBody();
      currentId = id;
    }

    function closeModal() {
      var overlay = document.getElementById("modal-overlay");
      var container = document.getElementById("modal-container");
      overlay.classList.remove("active");
      container.classList.remove("active");
      unlockBody();
      currentId = null;
    }

    var currentId = null;

    function isMobile() { return window.innerWidth < 640; }

    function showMobileSlide(id) {
      var slide = document.getElementById("mobile-slide");
      var body = document.getElementById("mobile-slide-body");
      var contents = body.querySelectorAll("div[id^='mobile-project-content-']");
      for (var i = 0; i < contents.length; i++) {
        var el = contents[i];
        el.classList.toggle("hidden", el.id !== "mobile-project-content-" + id);
      }
      // Set header title from project name
      var active = body.querySelector("#mobile-project-content-" + id + " h3");
      var title = document.getElementById("mobile-slide-title");
      if (title && active) title.textContent = active.textContent;
      slide.classList.add("translate-x-0");
      slide.classList.remove("translate-x-full");
      lockBody();
      currentId = id;
    }

    function closeMobileSlide() {
      var slide = document.getElementById("mobile-slide");
      slide.classList.add("translate-x-full");
      slide.classList.remove("translate-x-0");
      unlockBody();
      currentId = null;
    }

    // ===== Carousel =====
    document.addEventListener("click", function(e) {
      var prevBtn = e.target.closest(".carousel-prev");
      var nextBtn = e.target.closest(".carousel-next");
      var thumb = e.target.closest(".carousel-thumb");

      if (prevBtn || nextBtn) {
        e.preventDefault();
        var carousel = (prevBtn || nextBtn).closest(".project-carousel");
        if (!carousel) return;
        var images = JSON.parse(carousel.getAttribute("data-images"));
        var mainImg = carousel.querySelector("img:first-of-type");
        var counterEl = carousel.querySelector(".carousel-counter");
        var currentIdx = parseInt(carousel.getAttribute("data-current") || "0");
        var newIdx = prevBtn ? currentIdx - 1 : currentIdx + 1;
        if (newIdx < 0) newIdx = images.length - 1;
        if (newIdx >= images.length) newIdx = 0;
        carousel.setAttribute("data-current", newIdx);
        mainImg.classList.add("opacity-0", "scale-95");
        // Preload next image before fading
        var preload = new Image();
        preload.onload = function() {
          mainImg.src = images[newIdx];
          mainImg.alt = mainImg.alt.replace(/\d+/, String(newIdx + 1));
          mainImg.classList.remove("opacity-0", "scale-95");
        };
        preload.src = images[newIdx];
        if (counterEl) counterEl.textContent = (newIdx + 1) + " / " + images.length;
        carousel.querySelectorAll(".carousel-thumb").forEach(function(t, i) {
          t.style.borderColor = i === newIdx ? "#f97316" : "";
          t.style.opacity = i === newIdx ? "1" : "0.5";
        });
        var lightboxTrigger = carousel.querySelector("[data-open-lightbox]");
        if (lightboxTrigger) lightboxTrigger.setAttribute("data-index", newIdx);
      }

      if (thumb) {
        var carousel = thumb.closest(".project-carousel");
        if (!carousel) return;
        var images = JSON.parse(carousel.getAttribute("data-images"));
        var index = parseInt(thumb.getAttribute("data-index"));
        var mainImg = carousel.querySelector("img:first-of-type");
        var counterEl = carousel.querySelector(".carousel-counter");
        carousel.setAttribute("data-current", index);
        mainImg.classList.add("opacity-0", "scale-95");
        var preload = new Image();
        preload.onload = function() {
          mainImg.src = images[index];
          mainImg.alt = mainImg.alt.replace(/\d+/, String(index + 1));
          mainImg.classList.remove("opacity-0", "scale-95");
        };
        preload.src = images[index];
        if (counterEl) counterEl.textContent = (index + 1) + " / " + images.length;
        carousel.querySelectorAll(".carousel-thumb").forEach(function(t, i) {
          t.style.borderColor = i === index ? "#f97316" : "";
          t.style.opacity = i === index ? "1" : "0.5";
        });
        var lightboxTrigger = carousel.querySelector("[data-open-lightbox]");
        if (lightboxTrigger) lightboxTrigger.setAttribute("data-index", index);
      }
    });

    // Initialize carousel thumbnails active state
    document.querySelectorAll(".project-carousel").forEach(function(carousel) {
      var thumbs = carousel.querySelectorAll(".carousel-thumb");
      if (thumbs.length > 0) {
        thumbs[0].style.borderColor = "#f97316";
        for (var i = 1; i < thumbs.length; i++) thumbs[i].style.opacity = "0.5";
      }
    });

    // ===== Lightbox =====
    var lbImages = [];
    var lbIndex = 0;
    var lbTrack = document.getElementById("lightbox-track");
    var lbCounter = document.getElementById("lightbox-counter");
    var lbPrev = document.getElementById("lightbox-prev");
    var lbNext = document.getElementById("lightbox-next");

    function buildLightboxImages() {
      lbTrack.innerHTML = "";
      for (var i = 0; i < lbImages.length; i++) {
        var img = document.createElement("img");
        img.src = lbImages[i];
        img.alt = "Screenshot " + (i + 1);
        img.className = "flex-shrink-0 w-screen max-h-[85vh] object-contain select-none";
        img.style.width = "100vw";
        img.draggable = false;
        lbTrack.appendChild(img);
      }
      positionLightboxTrack(false);
    }

    function positionLightboxTrack(animate) {
      lbTrack.style.transition = animate ? "transform 0.3s ease-out" : "none";
      lbTrack.style.transform = "translateX(calc(-" + lbIndex + " * 100vw))";
      lbCounter.textContent = (lbIndex + 1) + " / " + lbImages.length;
      if (lbImages.length <= 1) {
        lbPrev.style.display = "none";
        lbNext.style.display = "none";
      } else {
        lbPrev.style.display = "";
        lbNext.style.display = "";
      }
    }

    function showLightbox(images, index) {
      lbImages = images;
      lbIndex = index;
      buildLightboxImages();
      var overlay = document.getElementById("lightbox-overlay");
      overlay.classList.add("active");
      lockBody();
    }

    function closeLightbox() {
      var overlay = document.getElementById("lightbox-overlay");
      overlay.classList.remove("active");
      unlockBody();
    }

    // Swipe with track preview
    var swipeStartX = 0;
    var swipeCurrentX = 0;
    var swipeActive = false;

    lbTrack.addEventListener("touchstart", function(e) {
      if (lbImages.length <= 1) return;
      swipeStartX = e.changedTouches[0].screenX;
      swipeCurrentX = swipeStartX;
      swipeActive = true;
      lbTrack.style.transition = "none";
    }, { passive: true });

    lbTrack.addEventListener("touchmove", function(e) {
      if (!swipeActive) return;
      swipeCurrentX = e.changedTouches[0].screenX;
      var diff = swipeCurrentX - swipeStartX;
      lbTrack.style.transform = "translateX(calc(-" + lbIndex + " * 100vw + " + diff + "px))";
    }, { passive: true });

    lbTrack.addEventListener("touchend", function() {
      if (!swipeActive) return;
      swipeActive = false;
      var diff = swipeCurrentX - swipeStartX;

      if (Math.abs(diff) > 50) {
        if (diff < 0) {
          lbIndex = lbIndex >= lbImages.length - 1 ? 0 : lbIndex + 1;
        } else {
          lbIndex = lbIndex <= 0 ? lbImages.length - 1 : lbIndex - 1;
        }
      }
      positionLightboxTrack(true);
    });

    // Prev/Next buttons
    function lbPrevClick() {
      lbIndex = lbIndex <= 0 ? lbImages.length - 1 : lbIndex - 1;
      positionLightboxTrack(true);
    }
    function lbNextClick() {
      lbIndex = lbIndex >= lbImages.length - 1 ? 0 : lbIndex + 1;
      positionLightboxTrack(true);
    }

    document.addEventListener("click", function(e) {
      // Open lightbox from carousel main image
      var trigger = e.target.closest("[data-open-lightbox]");
      if (trigger) {
        e.preventDefault();
        var carousel = trigger.closest(".project-carousel");
        if (!carousel) return;
        var images = JSON.parse(carousel.getAttribute("data-images"));
        var index = parseInt(trigger.getAttribute("data-index") || carousel.getAttribute("data-current") || "0");
        showLightbox(images, index);
        return;
      }

      // Open lightbox from mobile thumbnail
      var mobileBtn = e.target.closest("[data-mobile-lightbox]");
      if (mobileBtn) {
        e.preventDefault();
        var carousel = mobileBtn.closest(".project-carousel");
        if (!carousel) return;
        var images = JSON.parse(carousel.getAttribute("data-images"));
        showLightbox(images, 0);
        return;
      }

      // Lightbox prev/next
      if (e.target.closest("#lightbox-prev")) {
        lbPrevClick();
      }
      if (e.target.closest("#lightbox-next")) {
        lbNextClick();
      }

      // Close lightbox
      if (e.target.closest("#lightbox-close") || e.target === document.getElementById("lightbox-overlay")) {
        closeLightbox();
      }
    });

    document.addEventListener("keydown", function(e) {
      var lb = document.getElementById("lightbox-overlay");
      var lbOpen = lb && lb.classList.contains("active");

      if (lbOpen) {
        if (e.key === "Escape") closeLightbox();
        if (e.key === "ArrowLeft") { lbIndex = lbIndex <= 0 ? lbImages.length - 1 : lbIndex - 1; updateLightboxImage(); }
        if (e.key === "ArrowRight") { lbIndex = lbIndex >= lbImages.length - 1 ? 0 : lbIndex + 1; updateLightboxImage(); }
        return;
      }

      if (e.key === "Escape" && currentId) {
        closeModal();
        closeMobileSlide();
      }
    });

    document.addEventListener("click", function (e) {
      var card = e.target.closest("[data-open-modal]");
      if (card) {
        var id = card.getAttribute("data-project-id");
        if (!id) return;
        if (isMobile()) {
          showMobileSlide(id);
        } else {
          showModal(id);
        }
      }
      if (
        e.target.closest(".modal-close-btn") ||
        e.target === document.getElementById("modal-overlay")
      ) {
        closeModal();
      }
      if (e.target.closest("#mobile-slide-close")) {
        closeMobileSlide();
      }
    });

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -200px 0px" }
    );

    document.querySelectorAll(".reveal, .reveal-left, .reveal-right, .reveal-scale").forEach(function (el) {
      observer.observe(el);
    });

    var sections = ["projects", "studies", "skills", "contact"];
    var navLinks = document.querySelectorAll(".nav-link");

    document.addEventListener("click", function(e) {
      var link = e.target.closest('a[href^="#"]');
      if (link) {
        var href = link.getAttribute("href");
        if (href && href.length > 1) {
          e.preventDefault();
          var esSec = document.getElementById(href.slice(1));
          if (!esSec) return;
          var esParent = document.getElementById("lang-es");
          var enParent = document.getElementById("lang-en");
          var idx = 0; while (idx < esParent.children.length && esParent.children[idx] !== esSec) idx++;
          var visible = enParent.style.display !== "none" ? enParent : esParent;
          var target = visible.children[idx] || esSec;
          target.scrollIntoView({ behavior: "smooth" });
          history.replaceState(null, "", href);
        }
      }
    });
    
    window.addEventListener("scroll", function() {
      var current = "";
      var docEl = document.documentElement;
      var atBottom = docEl.scrollTop + window.innerHeight >= docEl.scrollHeight - 10;

      if (atBottom) {
        current = "contact";
      } else {
        sections.forEach(function(section) {
          var esSec = document.getElementById(section);
          if (!esSec) return;
          var esParent = document.getElementById("lang-es");
          var enParent = document.getElementById("lang-en");
          var idx = 0; while (idx < esParent.children.length && esParent.children[idx] !== esSec) idx++;
          var visible = enParent.style.display !== "none" ? enParent : esParent;
          var element = visible.children[idx] || esSec;
          if (element) {
            var rect = element.getBoundingClientRect();
            if (rect.top <= 200) {
              current = section;
            }
          }
        });
      }
      
      navLinks.forEach(function(link) {
        link.classList.remove("active");
        if (link.getAttribute("href") === "#" + current) {
          link.classList.add("active");
        }
      });
    });
  </script>
</Layout>
